    {
      "index": 34,
      "text": "[وقفة: 30]",
      "file": "c034.ogg",
      "durationSec": 4.512
    },
    {
      "index": 35,
      "text": "إذا كان العقل يتسابق للأمام، فاشكره على محاولته حمايتك.",
      "file": "c035.ogg",
      "durationSec": 10.848
