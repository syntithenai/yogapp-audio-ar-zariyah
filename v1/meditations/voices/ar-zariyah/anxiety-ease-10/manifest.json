    {
      "index": 32,
      "text": "يشعر بالحركة تحت اليد.",
      "file": "c032.ogg",
      "durationSec": 5.256
    },
    {
      "index": 33,
      "text": "قل بهدوء: الآن، أنا أتنفس.",
