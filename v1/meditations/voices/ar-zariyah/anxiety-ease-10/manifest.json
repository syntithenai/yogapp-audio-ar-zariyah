      "durationSec": 4.848
    },
    {
      "index": 26,
      "text": "عقد لمدة سنتين.",
      "file": "c026.ogg",
      "durationSec": 4.728
    },
    {
      "index": 27,
      "text": "خارج لمدة ستة.",
