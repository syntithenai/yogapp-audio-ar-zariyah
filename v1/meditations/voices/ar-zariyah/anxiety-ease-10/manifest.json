    },
    {
      "index": 15,
      "text": "[وقفة: 25]",
      "file": "c015.ogg",
      "durationSec": 5.208
    },
    {
      "index": 16,
      "text": "اضغط على القدمين بلطف على الأرض.",
      "file": "c016.ogg",
      "durationSec": 6.048
    },
    {
      "index": 17,
      "text": "اشعر بالأرضية تضغط للخلف.",
