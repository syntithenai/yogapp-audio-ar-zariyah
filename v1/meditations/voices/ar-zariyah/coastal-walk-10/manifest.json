{
  "id": "coastal-walk-10",
  "voiceId": "ar-zariyah",
  "edgeVoice": "ar-SA-ZariyahNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 703,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "ابحث عن وضعية لا تطلب منك شيئًا.",
      "file": "c001.ogg",
      "durationSec": 6.624
    },
    {
      "index": 2,
      "text": "اجلس، أو استلقِ، مع أي دعم تحتاجه.",
      "file": "c002.ogg",
      "durationSec": 7.656
    },
    {
      "index": 3,
      "text": "دع يديك تستريح مفتوحة أو ناعمة.",
      "file": "c003.ogg",
      "durationSec": 6.72
    },
    {
      "index": 4,
      "text": "اسمح لعينيك بالإغلاق، أو احتفظ بنظرة ناعمة.",
      "file": "c004.ogg",
      "durationSec": 8.88
    },
    {
      "index": 5,
      "text": "اشعر بالأماكن التي يلتقي فيها جسمك بالأرض.",
      "file": "c005.ogg",
      "durationSec": 7.584
    },
    {
      "index": 6,
      "text": "الكعب أو عظام الجلوس أو مؤخرة الرأس أو طول العمود الفقري.",
      "file": "c006.ogg",
      "durationSec": 9.6
    },
    {
      "index": 7,
      "text": "لا شيء يصمد الآن.",
      "file": "c007.ogg",
      "durationSec": 4.416
    },
    {
      "index": 8,
      "text": "خذ نفسا بطيئا من خلال الأنف.",
      "file": "c008.ogg",
      "durationSec": 5.664
    },
    {
      "index": 9,
      "text": "اشعر ببرودة الهواء القادمة.",
      "file": "c009.ogg",
      "durationSec": 5.376
    },
    {
      "index": 10,
      "text": "والزفير لفترة أطول قليلا.",
      "file": "c010.ogg",
      "durationSec": 5.952
    },
    {
      "index": 11,
      "text": "اشعر بدفء الزفير المغادر.",
      "file": "c011.ogg",
      "durationSec": 5.328
    },
    {
      "index": 12,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c012.ogg",
      "durationSec": 7.224
    },
    {
      "index": 13,
      "text": "الزفير غير مستعجل.",
      "file": "c013.ogg",
      "durationSec": 4.752
    },
    {
      "index": 14,
      "text": "دع الكتفين يسقطون جزءًا.",
      "file": "c014.ogg",
      "durationSec": 5.472
    },
    {
      "index": 15,
      "text": "دع الفك ينفتح.",
      "file": "c015.ogg",
      "durationSec": 4.2
    },
    {
      "index": 16,
      "text": "دع البطن يكون ناعما.",
      "file": "c016.ogg",
      "durationSec": 4.776
    },
    {
      "index": 17,
      "text": "ابق مع ثلاثة أنفاس هادئة، تمامًا كما هي.",
      "file": "c017.ogg",
      "durationSec": 8.04
    },
    {
      "index": 18,
      "text": "يستنشق. يصل.",
      "file": "c018.ogg",
      "durationSec": 5.664
    },
    {
      "index": 19,
      "text": "الزفير. يستقر.",
      "file": "c019.ogg",
      "durationSec": 6.0
    },
    {
      "index": 20,
      "text": "إذا شرد العقل، لاحظ ذلك بلطف، ثم عد إلى هذا النفس.",
      "file": "c020.ogg",
      "durationSec": 9.96
    },
    {
      "index": 21,
      "text": "شاهد المسار الساحلي على طول المنحدرات المنخفضة.",
      "file": "c021.ogg",
      "durationSec": 8.136
    },
    {
      "index": 22,
      "text": "يتنفس المحيط في الأسفل على شكل لفات طويلة وثابتة.",
      "file": "c022.ogg",
      "durationSec": 9.024
    },
    {
      "index": 23,
      "text": "ضوء الشمس يدفئ تاج رأسك وجسر أنفك.",
      "file": "c023.ogg",
      "durationSec": 7.464
    },
    {
      "index": 24,
      "text": "نسيم الملح يبرد جفونك بالانتعاش المشرق.",
      "file": "c024.ogg",
      "durationSec": 7.56
    },
    {
      "index": 25,
      "text": "رائحة البحر - معدنية، نظيفة، مستيقظا.",
      "file": "c025.ogg",
      "durationSec": 8.904
    },
    {
      "index": 26,
      "text": "أنت تمشي ببطء. الأعشاب تميل إلى الداخل في مهب الريح.",
      "file": "c026.ogg",
      "durationSec": 10.704
    },
    {
      "index": 27,
      "text": "اشعر بالشمس على أحد خديك والهواء البارد على الجانب الآخر.",
      "file": "c027.ogg",
      "durationSec": 9.24
    },
    {
      "index": 28,
      "text": "وهذا التباين هو في حد ذاته نوع من الهدوء.",
      "file": "c028.ogg",
      "durationSec": 7.8
    },
    {
      "index": 29,
      "text": "يؤدي درج خشبي إلى الأسفل نحو الشاطئ المخفي.",
      "file": "c029.ogg",
      "durationSec": 7.848
    },
    {
      "index": 30,
      "text": "كل خطوة مؤكدة. يدك تقع على السكك الحديدية نجا.",
      "file": "c030.ogg",
      "durationSec": 10.776
    },
    {
      "index": 31,
      "text": "الخشب الدافئ تحت راحة يدك.",
      "file": "c031.ogg",
      "durationSec": 5.736
    },
    {
      "index": 32,
      "text": "في الأسفل، يستقبل الرمل قدميك كنعم ناعمة.",
      "file": "c032.ogg",
      "durationSec": 8.472
    },
    {
      "index": 33,
      "text": "امشي إلى حيث تكتب الأمواج وتمحو الخطوط البيضاء.",
      "file": "c033.ogg",
      "durationSec": 8.208
    },
    {
      "index": 34,
      "text": "يطوي الماء البارد فوق كاحليك.",
      "file": "c034.ogg",
      "durationSec": 5.952
    },
    {
      "index": 35,
      "text": "الرمال الدافئة أعلى الشاطئ تنتظرك عندما تتراجع.",
      "file": "c035.ogg",
      "durationSec": 7.944
    },
    {
      "index": 36,
      "text": "يجلس. احفر يديك في الحبوب المسخنة بالشمس.",
      "file": "c036.ogg",
      "durationSec": 9.528
    },
    {
      "index": 37,
      "text": "اشعر بهذا الدفء الجاف على الرمال الرطبة الباردة تحتها.",
      "file": "c037.ogg",
      "durationSec": 8.496
    },
    {
      "index": 38,
      "text": "شاهد تحطم الضوء عبر المياه المفتوحة.",
      "file": "c038.ogg",
      "durationSec": 6.912
    },
    {
      "index": 39,
      "text": "تنفس في نضارة النسيم.",
      "file": "c039.ogg",
      "durationSec": 5.256
    },
    {
      "index": 40,
      "text": "قم بالزفير من أي ضيق لا يزال موجودًا في الضلوع.",
      "file": "c040.ogg",
      "durationSec": 8.184
    },
    {
      "index": 41,
      "text": "يبكي النورس مرة واحدة ويصبح جزءاً من الصمت.",
      "file": "c041.ogg",
      "durationSec": 8.88
    },
    {
      "index": 42,
      "text": "استلقِ. أغمض عينيك.",
      "file": "c042.ogg",
      "durationSec": 6.336
    },
    {
      "index": 43,
      "text": "الدفء عبر الجبهة الخاصة بك. ظل أرضي بارد على جانبيك.",
      "file": "c043.ogg",
      "durationSec": 11.28
    },
    {
      "index": 44,
      "text": "إيقاع المد والجزر يدرب قلبك نحو السهولة.",
      "file": "c044.ogg",
      "durationSec": 7.704
    },
    {
      "index": 45,
      "text": "أنت صغير بأفضل طريقة - مقيد بشيء واسع ولطيف.",
      "file": "c045.ogg",
      "durationSec": 9.648
    },
    {
      "index": 46,
      "text": "ابق مع دفء الشمس على عينيك المغمضتين.",
      "file": "c046.ogg",
      "durationSec": 7.08
    },
    {
      "index": 47,
      "text": "ابقِ مع قبلة الرذاذ الباردة على بشرتك عندما تهب الرياح.",
      "file": "c047.ogg",
      "durationSec": 9.216
    },
    {
      "index": 48,
      "text": "السلام ليس في مكان آخر. إنه هذا الشاطئ، وهذا النفس، وهذا الجسد.",
      "file": "c048.ogg",
      "durationSec": 13.32
    },
    {
      "index": 49,
      "text": "احفر كعبك بشكل أعمق قليلاً في الرمال الدافئة.",
      "file": "c049.ogg",
      "durationSec": 7.752
    },
    {
      "index": 50,
      "text": "اشعر كيف تستجيب الأرض بدعم ثابت.",
      "file": "c050.ogg",
      "durationSec": 6.744
    },
    {
      "index": 51,
      "text": "تنفس نضارة الملح إلى أسفل الرئتين.",
      "file": "c051.ogg",
      "durationSec": 6.864
    },
    {
      "index": 52,
      "text": "قم بإخراج أي شيء كان يستعد للتأثير.",
      "file": "c052.ogg",
      "durationSec": 7.104
    },
    {
      "index": 53,
      "text": "لا يوجد أي تأثير هنا. الوصول فقط بعد وصول الأمواج.",
      "file": "c053.ogg",
      "durationSec": 10.752
    },
    {
      "index": 54,
      "text": "دع خمسة أنفاس تركب نفس إيقاع المريض.",
      "file": "c054.ogg",
      "durationSec": 7.128
    },
    {
      "index": 55,
      "text": "ثم استريحي في شفق الشمس على الجلد.",
      "file": "c055.ogg",
      "durationSec": 6.456
    },
    {
      "index": 56,
      "text": "قم بالسير على خط الماء لمسافة قصيرة.",
      "file": "c056.ogg",
      "durationSec": 7.152
    },
    {
      "index": 57,
      "text": "القدم اليسرى باردة ورطبة. القدم اليمنى دافئة وجافة. ثم التبديل.",
      "file": "c057.ogg",
      "durationSec": 14.376
    },
    {
      "index": 58,
      "text": "يتعلم الجسم التباين باعتباره راحة وليس صراعًا.",
      "file": "c058.ogg",
      "durationSec": 8.832
    },
    {
      "index": 59,
      "text": "التقط حجرًا أملسًا دافئًا بالضوء.",
      "file": "c059.ogg",
      "durationSec": 6.216
    },
    {
      "index": 60,
      "text": "اشعر بحرارتها في راحة يدك. كثافته. إنه هادئ.",
      "file": "c060.ogg",
      "durationSec": 12.168
    },
    {
      "index": 61,
      "text": "ضعها جانبًا مع الشكر، فلا داعي للاحتفاظ بها.",
      "file": "c061.ogg",
      "durationSec": 8.136
    },
    {
      "index": 62,
      "text": "الحفظ يكون في الداخل.",
      "file": "c062.ogg",
      "durationSec": 4.752
    },
    {
      "index": 63,
      "text": "ابحث عن القواطع للحصول على لون أكثر هدوءًا.",
      "file": "c063.ogg",
      "durationSec": 8.064
    },
    {
      "index": 64,
      "text": "تنفس كما لو كنت تستطيع تذوق اللون الأزرق.",
      "file": "c064.ogg",
      "durationSec": 7.848
    },
    {
      "index": 65,
      "text": "نسيم منعش. الخد الدافئ. بطن ناعم.",
      "file": "c065.ogg",
      "durationSec": 10.656
    },
    {
      "index": 66,
      "text": "دع الشهيق التالي يكون أعمق ممارسة.",
      "file": "c066.ogg",
      "durationSec": 6.696
    },
    {
      "index": 67,
      "text": "دع الزفير يفرغ بدون قوة.",
      "file": "c067.ogg",
      "durationSec": 5.472
    },
    {
      "index": 68,
      "text": "الخليج الصغير، والجرف، وطريق العودة إلى المنزل - كلها تنتظر دون ضغوط.",
      "file": "c068.ogg",
      "durationSec": 13.104
    },
    {
      "index": 69,
      "text": "الآن دع القصة ترتاح، وابقَ مع الإحساس.",
      "file": "c069.ogg",
      "durationSec": 7.848
    },
    {
      "index": 70,
      "text": "يستنشق نضارة هذا المكان.",
      "file": "c070.ogg",
      "durationSec": 5.496
    },
    {
      "index": 71,
      "text": "الزفير في الدفء والهدوء.",
      "file": "c071.ogg",
      "durationSec": 4.968
    },
    {
      "index": 72,
      "text": "يستنشق.",
      "file": "c072.ogg",
      "durationSec": 2.976
    },
    {
      "index": 73,
      "text": "الزفير.",
      "file": "c073.ogg",
      "durationSec": 3.048
    },
    {
      "index": 74,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c074.ogg",
      "durationSec": 7.224
    },
    {
      "index": 75,
      "text": "زفير أطول.",
      "file": "c075.ogg",
      "durationSec": 3.744
    },
    {
      "index": 76,
      "text": "اشعر بالجسد ممسكًا بأرض هذا العالم المتخيل.",
      "file": "c076.ogg",
      "durationSec": 7.92
    },
    {
      "index": 77,
      "text": "يستنشق.",
      "file": "c077.ogg",
      "durationSec": 2.976
    },
    {
      "index": 78,
      "text": "الزفير.",
      "file": "c078.ogg",
      "durationSec": 3.048
    },
    {
      "index": 79,
      "text": "إذا شردت الأفكار، ارجع إلى الدفء على الجلد.",
      "file": "c079.ogg",
      "durationSec": 7.656
    },
    {
      "index": 80,
      "text": "أو لتبريد الهواء عند الأنف.",
      "file": "c080.ogg",
      "durationSec": 5.208
    },
    {
      "index": 81,
      "text": "يستنشق.",
      "file": "c081.ogg",
      "durationSec": 2.976
    },
    {
      "index": 82,
      "text": "الزفير.",
      "file": "c082.ogg",
      "durationSec": 3.048
    },
    {
      "index": 83,
      "text": "يستنشق.",
      "file": "c083.ogg",
      "durationSec": 2.976
    },
    {
      "index": 84,
      "text": "الزفير.",
      "file": "c084.ogg",
      "durationSec": 3.048
    },
    {
      "index": 85,
      "text": "يقضي. تليين. يكمل.",
      "file": "c085.ogg",
      "durationSec": 8.352
    },
    {
      "index": 86,
      "text": "يستنشق.",
      "file": "c086.ogg",
      "durationSec": 2.976
    },
    {
      "index": 87,
      "text": "الزفير.",
      "file": "c087.ogg",
      "durationSec": 3.048
    },
    {
      "index": 88,
      "text": "دورة أخرى سهلة.",
      "file": "c088.ogg",
      "durationSec": 4.32
    },
    {
      "index": 89,
      "text": "يستنشق.",
      "file": "c089.ogg",
      "durationSec": 2.976
    },
    {
      "index": 90,
      "text": "الزفير.",
      "file": "c090.ogg",
      "durationSec": 3.048
    },
    {
      "index": 91,
      "text": "استمر في هذا الشعور لبضعة أنفاس أخرى.",
      "file": "c091.ogg",
      "durationSec": 7.08
    },
    {
      "index": 92,
      "text": "الدفء. نعومة. كفاية.",
      "file": "c092.ogg",
      "durationSec": 7.896
    },
    {
      "index": 93,
      "text": "يمكنك العودة إلى هذا المكان عندما تحتاج إليه.",
      "file": "c093.ogg",
      "durationSec": 8.112
    },
    {
      "index": 94,
      "text": "إنه يعيش في انتباهك، وليس في خيالك فقط.",
      "file": "c094.ogg",
      "durationSec": 7.944
    },
    {
      "index": 95,
      "text": "البدء في تعميق التنفس.",
      "file": "c095.ogg",
      "durationSec": 5.136
    },
    {
      "index": 96,
      "text": "اشعر بالغرفة من حولك مرة أخرى.",
      "file": "c096.ogg",
      "durationSec": 6.624
    },
    {
      "index": 97,
      "text": "تذبذب الأصابع. تنعيم أصابع القدم.",
      "file": "c097.ogg",
      "durationSec": 8.184
    },
    {
      "index": 98,
      "text": "عندما تكون مستعدا، افتح عينيك.",
      "file": "c098.ogg",
      "durationSec": 7.032
    },
    {
      "index": 99,
      "text": "خذ نفسًا سهلاً آخر.",
      "file": "c099.ogg",
      "durationSec": 4.56
    },
    {
      "index": 100,
      "text": "احمل هذا الهدوء إلى كل ما يأتي بعد ذلك.",
      "file": "c100.ogg",
      "durationSec": 6.984
    }
  ]
}
