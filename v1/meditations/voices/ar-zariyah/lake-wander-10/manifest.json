{
  "id": "lake-wander-10",
  "voiceId": "ar-zariyah",
  "edgeVoice": "ar-SA-ZariyahNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 716,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "ابحث عن وضعية لا تطلب منك شيئًا.",
      "file": "c001.ogg",
      "durationSec": 6.624
    },
    {
      "index": 2,
      "text": "اجلس، أو استلقِ، مع أي دعم تحتاجه.",
      "file": "c002.ogg",
      "durationSec": 7.656
    },
    {
      "index": 3,
      "text": "دع يديك تستريح مفتوحة أو ناعمة.",
      "file": "c003.ogg",
      "durationSec": 6.72
    },
    {
      "index": 4,
      "text": "اسمح لعينيك بالإغلاق، أو احتفظ بنظرة ناعمة.",
      "file": "c004.ogg",
      "durationSec": 8.88
    },
    {
      "index": 5,
      "text": "اشعر بالأماكن التي يلتقي فيها جسمك بالأرض.",
      "file": "c005.ogg",
      "durationSec": 7.584
    },
    {
      "index": 6,
      "text": "الكعب أو عظام الجلوس أو مؤخرة الرأس أو طول العمود الفقري.",
      "file": "c006.ogg",
      "durationSec": 9.6
    },
    {
      "index": 7,
      "text": "لا شيء يصمد الآن.",
      "file": "c007.ogg",
      "durationSec": 4.416
    },
    {
      "index": 8,
      "text": "خذ نفسا بطيئا من خلال الأنف.",
      "file": "c008.ogg",
      "durationSec": 5.664
    },
    {
      "index": 9,
      "text": "اشعر ببرودة الهواء القادمة.",
      "file": "c009.ogg",
      "durationSec": 5.376
    },
    {
      "index": 10,
      "text": "والزفير لفترة أطول قليلا.",
      "file": "c010.ogg",
      "durationSec": 5.952
    },
    {
      "index": 11,
      "text": "اشعر بدفء الزفير المغادر.",
      "file": "c011.ogg",
      "durationSec": 5.328
    },
    {
      "index": 12,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c012.ogg",
      "durationSec": 7.224
    },
    {
      "index": 13,
      "text": "الزفير غير مستعجل.",
      "file": "c013.ogg",
      "durationSec": 4.752
    },
    {
      "index": 14,
      "text": "دع الكتفين يسقطون جزءًا.",
      "file": "c014.ogg",
      "durationSec": 5.472
    },
    {
      "index": 15,
      "text": "دع الفك ينفتح.",
      "file": "c015.ogg",
      "durationSec": 4.2
    },
    {
      "index": 16,
      "text": "دع البطن يكون ناعما.",
      "file": "c016.ogg",
      "durationSec": 4.776
    },
    {
      "index": 17,
      "text": "ابق مع ثلاثة أنفاس هادئة، تمامًا كما هي.",
      "file": "c017.ogg",
      "durationSec": 8.04
    },
    {
      "index": 18,
      "text": "يستنشق. يصل.",
      "file": "c018.ogg",
      "durationSec": 5.664
    },
    {
      "index": 19,
      "text": "الزفير. يستقر.",
      "file": "c019.ogg",
      "durationSec": 6.0
    },
    {
      "index": 20,
      "text": "إذا شرد العقل، لاحظ ذلك بلطف، ثم عد إلى هذا النفس.",
      "file": "c020.ogg",
      "durationSec": 9.96
    },
    {
      "index": 21,
      "text": "تخيل الاستيقاظ بجانب بحيرة هادئة واسعة.",
      "file": "c021.ogg",
      "durationSec": 8.064
    },
    {
      "index": 22,
      "text": "ضوء الصباح يكمن ناعمًا على الماء.",
      "file": "c022.ogg",
      "durationSec": 6.192
    },
    {
      "index": 23,
      "text": "الهواء البارد يلامس خديك بنضارة نظيفة.",
      "file": "c023.ogg",
      "durationSec": 7.824
    },
    {
      "index": 24,
      "text": "الشمس الأولى تدفئ قمم قدميك.",
      "file": "c024.ogg",
      "durationSec": 6.216
    },
    {
      "index": 25,
      "text": "تبدأ المشي ببطء على طول الشاطئ.",
      "file": "c025.ogg",
      "durationSec": 6.0
    },
    {
      "index": 26,
      "text": "تتحرك الرمال والأحجار الناعمة الصغيرة بلطف تحت الأقدام.",
      "file": "c026.ogg",
      "durationSec": 9.432
    },
    {
      "index": 27,
      "text": "كل خطوة هي محادثة هادئة مع الأرض.",
      "file": "c027.ogg",
      "durationSec": 7.056
    },
    {
      "index": 28,
      "text": "يأتي النسيم من الماء – منعشًا وباردًا قليلاً.",
      "file": "c028.ogg",
      "durationSec": 7.512
    },
    {
      "index": 29,
      "text": "إنه يرفع الشعر في معابدك.",
      "file": "c029.ogg",
      "durationSec": 5.496
    },
    {
      "index": 30,
      "text": "رائحة الارز والحجارة الرطبة والصباح المفتوح.",
      "file": "c030.ogg",
      "durationSec": 7.704
    },
    {
      "index": 31,
      "text": "شاهد مالك الحزين وهو يقف في المياه الضحلة، ساكنًا تمامًا.",
      "file": "c031.ogg",
      "durationSec": 10.08
    },
    {
      "index": 32,
      "text": "أنت تطابق هذا السكون لبضعة أنفاس.",
      "file": "c032.ogg",
      "durationSec": 6.696
    },
    {
      "index": 33,
      "text": "ينمو الدفء على كتفيك مع صعود الشمس.",
      "file": "c033.ogg",
      "durationSec": 6.816
    },
    {
      "index": 34,
      "text": "ابحث عن صخرة مضاءة بنور الشمس واجلس.",
      "file": "c034.ogg",
      "durationSec": 7.176
    },
    {
      "index": 35,
      "text": "اشعر بالحرارة المخزنة في الحجر وهي ترتفع إلى جسمك.",
      "file": "c035.ogg",
      "durationSec": 9.288
    },
    {
      "index": 36,
      "text": "اشعر بالهواء المنعش يتحرك عبر شفتيك مع كل شهيق.",
      "file": "c036.ogg",
      "durationSec": 9.288
    },
    {
      "index": 37,
      "text": "يتجعد سطح البحيرة، ثم يتحول إلى زجاج مرة أخرى.",
      "file": "c037.ogg",
      "durationSec": 9.84
    },
    {
      "index": 38,
      "text": "يرتعش النور هناك كالفرح الهادئ.",
      "file": "c038.ogg",
      "durationSec": 6.12
    },
    {
      "index": 39,
      "text": "واصل السير حول منحنى الشاطئ إلى خليج صغير.",
      "file": "c039.ogg",
      "durationSec": 7.8
    },
    {
      "index": 40,
      "text": "يهمس القصب. القراد الماء بهدوء ضد الخشب.",
      "file": "c040.ogg",
      "durationSec": 9.48
    },
    {
      "index": 41,
      "text": "يمتد الرصيف القديم. أنت تمشي حتى النهاية.",
      "file": "c041.ogg",
      "durationSec": 9.192
    },
    {
      "index": 42,
      "text": "اجلس وقدماك متدليتان فوق الماء البارد.",
      "file": "c042.ogg",
      "durationSec": 7.608
    },
    {
      "index": 43,
      "text": "الشمس على ظهرك. نسيم على ساقيك.",
      "file": "c043.ogg",
      "durationSec": 8.52
    },
    {
      "index": 44,
      "text": "تراجع اصبع القدم. برد لطيف. ابتسامة لا تحتاج إلى إظهارها.",
      "file": "c044.ogg",
      "durationSec": 13.68
    },
    {
      "index": 45,
      "text": "استلقِ على الألواح الدافئة.",
      "file": "c045.ogg",
      "durationSec": 5.088
    },
    {
      "index": 46,
      "text": "اسمع الماء تحتك. السماء فوقك.",
      "file": "c046.ogg",
      "durationSec": 7.992
    },
    {
      "index": 47,
      "text": "أنفاسك تصبح واسعة مثل البحيرة.",
      "file": "c047.ogg",
      "durationSec": 6.672
    },
    {
      "index": 48,
      "text": "يستنشق نضارة. الزفير إلى اللون الأزرق الذي لا نهاية له.",
      "file": "c048.ogg",
      "durationSec": 10.824
    },
    {
      "index": 49,
      "text": "لا شيء لحلها. فقط هذا الدفء، هذا الهواء، هذا السلام.",
      "file": "c049.ogg",
      "durationSec": 11.664
    },
    {
      "index": 50,
      "text": "اشعر بحرارة الرصيف على طول عمودك الفقري.",
      "file": "c050.ogg",
      "durationSec": 7.488
    },
    {
      "index": 51,
      "text": "اشعر بشريط من الهواء البارد كلما هبت النسيم.",
      "file": "c051.ogg",
      "durationSec": 8.16
    },
    {
      "index": 52,
      "text": "اليعسوب يخيط الهواء ويرحل.",
      "file": "c052.ogg",
      "durationSec": 5.592
    },
    {
      "index": 53,
      "text": "ابق حتى يغرق الشعور في العضلات والعظام.",
      "file": "c053.ogg",
      "durationSec": 7.248
    },
    {
      "index": 54,
      "text": "إذا كان العقل يسرد المهام، فضعها على الشاطئ البعيد في الوقت الحالي.",
      "file": "c054.ogg",
      "durationSec": 10.68
    },
    {
      "index": 55,
      "text": "يمكنهم الانتظار. البحيرة لا تنتظر أي شيء.",
      "file": "c055.ogg",
      "durationSec": 10.056
    },
    {
      "index": 56,
      "text": "يد واحدة على البطن. يعلو. يسقط.",
      "file": "c056.ogg",
      "durationSec": 10.032
    },
    {
      "index": 57,
      "text": "الدفء تحت كف اليد الأخرى على الخشب.",
      "file": "c057.ogg",
      "durationSec": 6.336
    },
    {
      "index": 58,
      "text": "استرح في هذا القابض المزدوج – الجسد والمكان.",
      "file": "c058.ogg",
      "durationSec": 7.944
    },
    {
      "index": 59,
      "text": "الوقوف والمشي أبعد قليلا في الخيال.",
      "file": "c059.ogg",
      "durationSec": 6.912
    },
    {
      "index": 60,
      "text": "الحصى تنقر بهدوء. يضيء الماء بالقرب من الفرع الساقط.",
      "file": "c060.ogg",
      "durationSec": 11.04
    },
    {
      "index": 61,
      "text": "تجد الشمس الجزء الخلفي من رقبتك بالحرارة الودية.",
      "file": "c061.ogg",
      "durationSec": 8.496
    },
    {
      "index": 62,
      "text": "الظل من الصفصاف يبرد جفونك لبضع خطوات.",
      "file": "c062.ogg",
      "durationSec": 7.92
    },
    {
      "index": 63,
      "text": "يصبح الدفء والنضارة بالتناوب صلاة سيرًا على الأقدام.",
      "file": "c063.ogg",
      "durationSec": 8.88
    },
    {
      "index": 64,
      "text": "لا توجد كلمات مطلوبة. فقط الإحساس والتنفس.",
      "file": "c064.ogg",
      "durationSec": 9.792
    },
    {
      "index": 65,
      "text": "ابحث عن قطعة من الرمال الدافئة واجلس في مواجهة المياه المفتوحة.",
      "file": "c065.ogg",
      "durationSec": 9.888
    },
    {
      "index": 66,
      "text": "دع العيون تصبح ناعمة على خط الأفق.",
      "file": "c066.ogg",
      "durationSec": 7.128
    },
    {
      "index": 67,
      "text": "استنشق عطر البحيرة البارد.",
      "file": "c067.ogg",
      "durationSec": 5.592
    },
    {
      "index": 68,
      "text": "الزفير نحو التلال البعيدة.",
      "file": "c068.ogg",
      "durationSec": 5.208
    },
    {
      "index": 69,
      "text": "كل ما تحمله هنا يمكن أن يستريح على الشاطئ بجانبك.",
      "file": "c069.ogg",
      "durationSec": 8.976
    },
    {
      "index": 70,
      "text": "لا يحتاج إلى حمله في الماء.",
      "file": "c070.ogg",
      "durationSec": 5.208
    },
    {
      "index": 71,
      "text": "ابق حتى تشعر أن الأنفاس الثلاثة التالية كاملة من تلقاء نفسها.",
      "file": "c071.ogg",
      "durationSec": 10.392
    },
    {
      "index": 72,
      "text": "الآن دع القصة ترتاح، وابقَ مع الإحساس.",
      "file": "c072.ogg",
      "durationSec": 7.848
    },
    {
      "index": 73,
      "text": "يستنشق نضارة هذا المكان.",
      "file": "c073.ogg",
      "durationSec": 5.496
    },
    {
      "index": 74,
      "text": "الزفير في الدفء والهدوء.",
      "file": "c074.ogg",
      "durationSec": 4.968
    },
    {
      "index": 75,
      "text": "يستنشق.",
      "file": "c075.ogg",
      "durationSec": 2.976
    },
    {
      "index": 76,
      "text": "الزفير.",
      "file": "c076.ogg",
      "durationSec": 3.048
    },
    {
      "index": 77,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c077.ogg",
      "durationSec": 7.224
    },
    {
      "index": 78,
      "text": "زفير أطول.",
      "file": "c078.ogg",
      "durationSec": 3.744
    },
    {
      "index": 79,
      "text": "اشعر بالجسد ممسكًا بأرض هذا العالم المتخيل.",
      "file": "c079.ogg",
      "durationSec": 7.92
    },
    {
      "index": 80,
      "text": "يستنشق.",
      "file": "c080.ogg",
      "durationSec": 2.976
    },
    {
      "index": 81,
      "text": "الزفير.",
      "file": "c081.ogg",
      "durationSec": 3.048
    },
    {
      "index": 82,
      "text": "إذا شردت الأفكار، ارجع إلى الدفء على الجلد.",
      "file": "c082.ogg",
      "durationSec": 7.656
    },
    {
      "index": 83,
      "text": "أو لتبريد الهواء عند الأنف.",
      "file": "c083.ogg",
      "durationSec": 5.208
    },
    {
      "index": 84,
      "text": "يستنشق.",
      "file": "c084.ogg",
      "durationSec": 2.976
    },
    {
      "index": 85,
      "text": "الزفير.",
      "file": "c085.ogg",
      "durationSec": 3.048
    },
    {
      "index": 86,
      "text": "يستنشق.",
      "file": "c086.ogg",
      "durationSec": 2.976
    },
    {
      "index": 87,
      "text": "الزفير.",
      "file": "c087.ogg",
      "durationSec": 3.048
    },
    {
      "index": 88,
      "text": "يقضي. تليين. يكمل.",
      "file": "c088.ogg",
      "durationSec": 8.352
    },
    {
      "index": 89,
      "text": "يستنشق.",
      "file": "c089.ogg",
      "durationSec": 2.976
    },
    {
      "index": 90,
      "text": "الزفير.",
      "file": "c090.ogg",
      "durationSec": 3.048
    },
    {
      "index": 91,
      "text": "دورة أخرى سهلة.",
      "file": "c091.ogg",
      "durationSec": 4.32
    },
    {
      "index": 92,
      "text": "يستنشق.",
      "file": "c092.ogg",
      "durationSec": 2.976
    },
    {
      "index": 93,
      "text": "الزفير.",
      "file": "c093.ogg",
      "durationSec": 3.048
    },
    {
      "index": 94,
      "text": "استمر في هذا الشعور لبضعة أنفاس أخرى.",
      "file": "c094.ogg",
      "durationSec": 7.08
    },
    {
      "index": 95,
      "text": "الدفء. نعومة. كفاية.",
      "file": "c095.ogg",
      "durationSec": 7.896
    },
    {
      "index": 96,
      "text": "يمكنك العودة إلى هذا المكان عندما تحتاج إليه.",
      "file": "c096.ogg",
      "durationSec": 8.112
    },
    {
      "index": 97,
      "text": "إنه يعيش في انتباهك، وليس في خيالك فقط.",
      "file": "c097.ogg",
      "durationSec": 7.944
    },
    {
      "index": 98,
      "text": "البدء في تعميق التنفس.",
      "file": "c098.ogg",
      "durationSec": 5.136
    },
    {
      "index": 99,
      "text": "اشعر بالغرفة من حولك مرة أخرى.",
      "file": "c099.ogg",
      "durationSec": 6.624
    },
    {
      "index": 100,
      "text": "تذبذب الأصابع. تنعيم أصابع القدم.",
      "file": "c100.ogg",
      "durationSec": 8.184
    },
    {
      "index": 101,
      "text": "عندما تكون مستعدا، افتح عينيك.",
      "file": "c101.ogg",
      "durationSec": 7.032
    },
    {
      "index": 102,
      "text": "خذ نفسًا سهلاً آخر.",
      "file": "c102.ogg",
      "durationSec": 4.56
    },
    {
      "index": 103,
      "text": "احمل هذا الهدوء إلى كل ما يأتي بعد ذلك.",
      "file": "c103.ogg",
      "durationSec": 6.984
    }
  ]
}
