  "totalSec": 169,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "إذا شعرت بالتشتت أو النشاط، يمكن أن تساعدك هذه الممارسة.",
      "file": "c001.ogg",
      "durationSec": 10.584
    },
    {
      "index": 2,
      "text": "أبقِ أعينك مفتوحة الآن، إذا كان ذلك أكثر أمانًا.",
      "file": "c002.ogg",
      "durationSec": 9.432
    },
    {
      "index": 3,
      "text": "زرع كلا القدمين على الأرض.",
      "file": "c003.ogg",
      "durationSec": 5.256
    },
    {
      "index": 4,
      "text": "[وقفة: 17]",
      "file": "c004.ogg",
      "durationSec": 4.632
    },
    {
      "index": 5,
      "text": "اذكر خمسة أشياء يمكنك رؤيتها.",
      "file": "c005.ogg",
      "durationSec": 6.312
    },
    {
      "index": 6,
      "text": "بهدوء. خذ وقتك.",
      "file": "c006.ogg",
      "durationSec": 6.024
    },
    {
      "index": 7,
      "text": "[وقفة: 45]",
      "file": "c007.ogg",
      "durationSec": 5.304
    },
    {
      "index": 8,
      "text": "اذكر أربعة أشياء يمكنك الشعور بها أو لمسها.",
      "file": "c008.ogg",
      "durationSec": 7.92
    },
    {
      "index": 9,
      "text": "ملابس. كرسي. الهواء على الجلد. قدم على الأرض.",
      "file": "c009.ogg",
      "durationSec": 13.104
    },
    {
      "index": 10,
      "text": "[وقفة: 39]",
      "file": "c010.ogg",
      "durationSec": 5.496
    },
    {
      "index": 11,
      "text": "اذكر ثلاثة أصوات.",
      "file": "c011.ogg",
      "durationSec": 4.44
    },
    {
      "index": 12,
      "text": "قريب أو بعيد. ناعمة أو واضحة.",
      "file": "c012.ogg",
      "durationSec": 8.352
    },
    {
      "index": 13,
      "text": "[وقفة: 39]",
      "file": "c013.ogg",
      "durationSec": 5.496
    },
    {
      "index": 14,
      "text": "قم بتسمية رائحتين، أو ببساطة لاحظ جودة الهواء.",
      "file": "c014.ogg",
      "durationSec": 9.768
    },
    {
      "index": 15,
      "text": "[وقفة: 28]",
      "file": "c015.ogg",
      "durationSec": 5.448
    },
    {
      "index": 16,
      "text": "اذكر طعمًا واحدًا، أو الشعور داخل الفم.",
      "file": "c016.ogg",
      "durationSec": 7.68
    },
    {
      "index": 17,
      "text": "[وقفة: 23]",
      "file": "c017.ogg",
      "durationSec": 5.352
    },
    {
      "index": 18,
      "text": "أنت هنا. في هذا الجسد. في هذه الغرفة.",
      "file": "c018.ogg",
      "durationSec": 10.392
    },
    {
      "index": 19,
      "text": "تنفس لمدة أربعة.",
      "file": "c019.ogg",
      "durationSec": 4.848
    },
    {
      "index": 20,
      "text": "خارج لمدة ستة.",
      "file": "c020.ogg",
      "durationSec": 4.32
    },
    {
      "index": 21,
      "text": "[وقفة: 23]",
      "file": "c021.ogg",
      "durationSec": 5.352
    },
    {
      "index": 22,
      "text": "خذ نفسًا سهلاً آخر.",
      "file": "c022.ogg",
      "durationSec": 4.56
    },
    {
      "index": 23,
      "text": "تذبذب الأصابع.",
      "file": "c023.ogg",
      "durationSec": 3.792
    },
    {
      "index": 24,
      "text": "عندما تكون مستعدا، افتح عينيك.",
      "file": "c024.ogg",
      "durationSec": 7.032
    },
    {
      "index": 25,
      "text": "احمل القليل من هذا معك.",
      "file": "c025.ogg",
      "durationSec": 5.136
    }
  ]
}
