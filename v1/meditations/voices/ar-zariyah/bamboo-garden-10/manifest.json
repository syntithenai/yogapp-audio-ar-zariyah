{
  "id": "bamboo-garden-10",
  "voiceId": "ar-zariyah",
  "edgeVoice": "ar-SA-ZariyahNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 719,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "ابحث عن وضعية لا تطلب منك شيئًا.",
      "file": "c001.ogg",
      "durationSec": 6.624
    },
    {
      "index": 2,
      "text": "اجلس، أو استلقِ، مع أي دعم تحتاجه.",
      "file": "c002.ogg",
      "durationSec": 7.656
    },
    {
      "index": 3,
      "text": "دع يديك تستريح مفتوحة أو ناعمة.",
      "file": "c003.ogg",
      "durationSec": 6.72
    },
    {
      "index": 4,
      "text": "اسمح لعينيك بالإغلاق، أو احتفظ بنظرة ناعمة.",
      "file": "c004.ogg",
      "durationSec": 8.88
    },
    {
      "index": 5,
      "text": "اشعر بالأماكن التي يلتقي فيها جسمك بالأرض.",
      "file": "c005.ogg",
      "durationSec": 7.584
    },
    {
      "index": 6,
      "text": "الكعب أو عظام الجلوس أو مؤخرة الرأس أو طول العمود الفقري.",
      "file": "c006.ogg",
      "durationSec": 9.6
    },
    {
      "index": 7,
      "text": "لا شيء يصمد الآن.",
      "file": "c007.ogg",
      "durationSec": 4.416
    },
    {
      "index": 8,
      "text": "خذ نفسا بطيئا من خلال الأنف.",
      "file": "c008.ogg",
      "durationSec": 5.664
    },
    {
      "index": 9,
      "text": "اشعر ببرودة الهواء القادمة.",
      "file": "c009.ogg",
      "durationSec": 5.376
    },
    {
      "index": 10,
      "text": "والزفير لفترة أطول قليلا.",
      "file": "c010.ogg",
      "durationSec": 5.952
    },
    {
      "index": 11,
      "text": "اشعر بدفء الزفير المغادر.",
      "file": "c011.ogg",
      "durationSec": 5.328
    },
    {
      "index": 12,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c012.ogg",
      "durationSec": 7.224
    },
    {
      "index": 13,
      "text": "الزفير غير مستعجل.",
      "file": "c013.ogg",
      "durationSec": 4.752
    },
    {
      "index": 14,
      "text": "دع الكتفين يسقطون جزءًا.",
      "file": "c014.ogg",
      "durationSec": 5.472
    },
    {
      "index": 15,
      "text": "دع الفك ينفتح.",
      "file": "c015.ogg",
      "durationSec": 4.2
    },
    {
      "index": 16,
      "text": "دع البطن يكون ناعما.",
      "file": "c016.ogg",
      "durationSec": 4.776
    },
    {
      "index": 17,
      "text": "ابق مع ثلاثة أنفاس هادئة، تمامًا كما هي.",
      "file": "c017.ogg",
      "durationSec": 8.04
    },
    {
      "index": 18,
      "text": "يستنشق. يصل.",
      "file": "c018.ogg",
      "durationSec": 5.664
    },
    {
      "index": 19,
      "text": "الزفير. يستقر.",
      "file": "c019.ogg",
      "durationSec": 6.0
    },
    {
      "index": 20,
      "text": "إذا شرد العقل، لاحظ ذلك بلطف، ثم عد إلى هذا النفس.",
      "file": "c020.ogg",
      "durationSec": 9.96
    },
    {
      "index": 21,
      "text": "تصور حديقة الخيزران بعد المطر.",
      "file": "c021.ogg",
      "durationSec": 6.24
    },
    {
      "index": 22,
      "text": "الحجر مظلم ونظيف. أوراق تألق.",
      "file": "c022.ogg",
      "durationSec": 8.736
    },
    {
      "index": 23,
      "text": "نضارة باردة تملأ الهواء مثل الجرس الناعم.",
      "file": "c023.ogg",
      "durationSec": 7.656
    },
    {
      "index": 24,
      "text": "استراحة في الغيوم تسمح للشمس بالمرور.",
      "file": "c024.ogg",
      "durationSec": 7.176
    },
    {
      "index": 25,
      "text": "اشعري بالدفء اللطيف المفاجئ على جبهتك وعظام وجنتيك.",
      "file": "c025.ogg",
      "durationSec": 9.312
    },
    {
      "index": 26,
      "text": "يرتفع البخار بشكل خافت من المسار، وتتنفس الأرض.",
      "file": "c026.ogg",
      "durationSec": 9.36
    },
    {
      "index": 27,
      "text": "أنت تخطو على الحجارة الموجودة في الطحلب.",
      "file": "c027.ogg",
      "durationSec": 6.648
    },
    {
      "index": 28,
      "text": "كل حجر بارد وأكيد تحت الأقدام.",
      "file": "c028.ogg",
      "durationSec": 6.6
    },
    {
      "index": 29,
      "text": "صرير الخيزران وهمس في نسيم خفيف.",
      "file": "c029.ogg",
      "durationSec": 6.864
    },
    {
      "index": 30,
      "text": "الصوت أخضر. الصوت هادئ.",
      "file": "c030.ogg",
      "durationSec": 6.984
    },
    {
      "index": 31,
      "text": "تشم رائحة أوراق الشجر الرطبة والحجر وحلاوة باهتة من نباتات الشاي القريبة.",
      "file": "c031.ogg",
      "durationSec": 12.336
    },
    {
      "index": 32,
      "text": "وقفة بجانب بركة صغيرة.",
      "file": "c032.ogg",
      "durationSec": 5.784
    },
    {
      "index": 33,
      "text": "يتحرك كوي مثل الأفكار البطيئة تحت السطح.",
      "file": "c033.ogg",
      "durationSec": 7.416
    },
    {
      "index": 34,
      "text": "تعمل بقع الشمس على تدفئة معصميك بينما تضعهما على السكة.",
      "file": "c034.ogg",
      "durationSec": 10.248
    },
    {
      "index": 35,
      "text": "النسيم يبرد الرطوبة في صدغيك.",
      "file": "c035.ogg",
      "durationSec": 6.144
    },
    {
      "index": 36,
      "text": "النضارة في الداخل والنعومة في الخارج.",
      "file": "c036.ogg",
      "durationSec": 6.432
    },
    {
      "index": 37,
      "text": "اتبع ممشى مغطى بالخشب البالي.",
      "file": "c037.ogg",
      "durationSec": 5.976
    },
    {
      "index": 38,
      "text": "تكون الألواح باردة في الظل، وأكثر دفئًا في الأماكن التي يسقط فيها الضوء.",
      "file": "c038.ogg",
      "durationSec": 11.592
    },
    {
      "index": 39,
      "text": "تجلس على مقعد في مواجهة الحصى الممزق وحجر واحد مثالي.",
      "file": "c039.ogg",
      "durationSec": 10.224
    },
    {
      "index": 40,
      "text": "لا شيء يحتاج إلى إعادة ترتيب.",
      "file": "c040.ogg",
      "durationSec": 6.216
    },
    {
      "index": 41,
      "text": "اشعر بالهندسة الهادئة التي تستقر في عقلك.",
      "file": "c041.ogg",
      "durationSec": 7.92
    },
    {
      "index": 42,
      "text": "يعود الدفء عندما تخف السحابة - يد لطيفة على كتفيك.",
      "file": "c042.ogg",
      "durationSec": 9.624
    },
    {
      "index": 43,
      "text": "ثم الظل مرة أخرى، بارد ومريح.",
      "file": "c043.ogg",
      "durationSec": 7.464
    },
    {
      "index": 44,
      "text": "ارتشف الشاي الخيالي. تذوق الدفء. اشعر بحرارة الكأس في راحة يدك.",
      "file": "c044.ogg",
      "durationSec": 14.448
    },
    {
      "index": 45,
      "text": "خارج الحديقة، تستمر الحياة. في الداخل، الوقت يخفف.",
      "file": "c045.ogg",
      "durationSec": 11.592
    },
    {
      "index": 46,
      "text": "المشي مرة أخرى تحت الخيزران.",
      "file": "c046.ogg",
      "durationSec": 6.0
    },
    {
      "index": 47,
      "text": "دع السيقان الطويلة تؤثر على أنفاسك بنفس الإيقاع السهل.",
      "file": "c047.ogg",
      "durationSec": 8.832
    },
    {
      "index": 48,
      "text": "قطرات باردة من ورقة الشجر تجد معصمك - مفاجأة جديدة صغيرة.",
      "file": "c048.ogg",
      "durationSec": 11.736
    },
    {
      "index": 49,
      "text": "ثم تعرض للشمس مرة أخرى، ودافئة على نفس المكان حتى يجف.",
      "file": "c049.ogg",
      "durationSec": 10.944
    },
    {
      "index": 50,
      "text": "أنت تنتمي إلى هذا السلام طالما بقيت.",
      "file": "c050.ogg",
      "durationSec": 6.72
    },
    {
      "index": 51,
      "text": "وسيأتي معك خيط منه عندما تغادر.",
      "file": "c051.ogg",
      "durationSec": 6.888
    },
    {
      "index": 52,
      "text": "اجلس مرة أخرى. الأيدي مفتوحة على ركبتيك.",
      "file": "c052.ogg",
      "durationSec": 9.84
    },
    {
      "index": 53,
      "text": "الدفء أينما يمس الضوء. البرودة في ظل الخيزران.",
      "file": "c053.ogg",
      "durationSec": 10.008
    },
    {
      "index": 54,
      "text": "استنشق نضارة ما بعد المطر.",
      "file": "c054.ogg",
      "durationSec": 5.592
    },
    {
      "index": 55,
      "text": "قم بالزفير في هدوء الحجر والحصى.",
      "file": "c055.ogg",
      "durationSec": 6.024
    },
    {
      "index": 56,
      "text": "لم يبق شيء حاد. فقط الحواف الناعمة والهواء الكافي.",
      "file": "c056.ogg",
      "durationSec": 10.728
    },
    {
      "index": 57,
      "text": "العودة إلى البركة للتوقف النهائي.",
      "file": "c057.ogg",
      "durationSec": 6.624
    },
    {
      "index": 58,
      "text": "تتسع التموجات الناتجة عن القطرة المتساقطة وتختفي.",
      "file": "c058.ogg",
      "durationSec": 9.624
    },
    {
      "index": 59,
      "text": "ترقص رقاقات الشمس، ثم لا تزال.",
      "file": "c059.ogg",
      "durationSec": 6.888
    },
    {
      "index": 60,
      "text": "الدفء على عظام الخد. ذاكرة ضبابية باردة في الأنف.",
      "file": "c060.ogg",
      "durationSec": 10.824
    },
    {
      "index": 61,
      "text": "انحنى قليلاً نحو الحديقة – إيماءة صغيرة إلى الداخل.",
      "file": "c061.ogg",
      "durationSec": 8.544
    },
    {
      "index": 62,
      "text": "قم بالمشي على الحجارة مرة أخرى، بشكل أبطأ من ذي قبل.",
      "file": "c062.ogg",
      "durationSec": 9.528
    },
    {
      "index": 63,
      "text": "الطحلب البارد بين الحجارة. الخشب الدافئ لسكة حديد الجسر.",
      "file": "c063.ogg",
      "durationSec": 11.304
    },
    {
      "index": 64,
      "text": "يتحدث الخيزران بلغة أوراق الشجر في الأعلى.",
      "file": "c064.ogg",
      "durationSec": 7.704
    },
    {
      "index": 65,
      "text": "أنت تفهم ما يكفي منه: ابق، خفف، استمر.",
      "file": "c065.ogg",
      "durationSec": 9.072
    },
    {
      "index": 66,
      "text": "عند العتبة، اشعر بالعالمين: سلام الحديقة واليوم العادي.",
      "file": "c066.ogg",
      "durationSec": 10.2
    },
    {
      "index": 67,
      "text": "يمكنك تجديلهم.",
      "file": "c067.ogg",
      "durationSec": 4.344
    },
    {
      "index": 68,
      "text": "استنشاق نضارة الضفيرة.",
      "file": "c068.ogg",
      "durationSec": 4.92
    },
    {
      "index": 69,
      "text": "زفر الدفء في اليدين، وعلى استعداد لمواجهة ما سيأتي.",
      "file": "c069.ogg",
      "durationSec": 9.552
    },
    {
      "index": 70,
      "text": "وتبقى الحديقة سواء نظرت أم لا.",
      "file": "c070.ogg",
      "durationSec": 6.192
    },
    {
      "index": 71,
      "text": "الآن دع القصة ترتاح، وابقَ مع الإحساس.",
      "file": "c071.ogg",
      "durationSec": 7.848
    },
    {
      "index": 72,
      "text": "يستنشق نضارة هذا المكان.",
      "file": "c072.ogg",
      "durationSec": 5.496
    },
    {
      "index": 73,
      "text": "الزفير في الدفء والهدوء.",
      "file": "c073.ogg",
      "durationSec": 4.968
    },
    {
      "index": 74,
      "text": "يستنشق.",
      "file": "c074.ogg",
      "durationSec": 2.976
    },
    {
      "index": 75,
      "text": "الزفير.",
      "file": "c075.ogg",
      "durationSec": 3.048
    },
    {
      "index": 76,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c076.ogg",
      "durationSec": 7.224
    },
    {
      "index": 77,
      "text": "زفير أطول.",
      "file": "c077.ogg",
      "durationSec": 3.744
    },
    {
      "index": 78,
      "text": "اشعر بالجسد ممسكًا بأرض هذا العالم المتخيل.",
      "file": "c078.ogg",
      "durationSec": 7.92
    },
    {
      "index": 79,
      "text": "يستنشق.",
      "file": "c079.ogg",
      "durationSec": 2.976
    },
    {
      "index": 80,
      "text": "الزفير.",
      "file": "c080.ogg",
      "durationSec": 3.048
    },
    {
      "index": 81,
      "text": "إذا شردت الأفكار، ارجع إلى الدفء على الجلد.",
      "file": "c081.ogg",
      "durationSec": 7.656
    },
    {
      "index": 82,
      "text": "أو لتبريد الهواء عند الأنف.",
      "file": "c082.ogg",
      "durationSec": 5.208
    },
    {
      "index": 83,
      "text": "يستنشق.",
      "file": "c083.ogg",
      "durationSec": 2.976
    },
    {
      "index": 84,
      "text": "الزفير.",
      "file": "c084.ogg",
      "durationSec": 3.048
    },
    {
      "index": 85,
      "text": "يستنشق.",
      "file": "c085.ogg",
      "durationSec": 2.976
    },
    {
      "index": 86,
      "text": "الزفير.",
      "file": "c086.ogg",
      "durationSec": 3.048
    },
    {
      "index": 87,
      "text": "يقضي. تليين. يكمل.",
      "file": "c087.ogg",
      "durationSec": 8.352
    },
    {
      "index": 88,
      "text": "يستنشق.",
      "file": "c088.ogg",
      "durationSec": 2.976
    },
    {
      "index": 89,
      "text": "الزفير.",
      "file": "c089.ogg",
      "durationSec": 3.048
    },
    {
      "index": 90,
      "text": "دورة أخرى سهلة.",
      "file": "c090.ogg",
      "durationSec": 4.32
    },
    {
      "index": 91,
      "text": "يستنشق.",
      "file": "c091.ogg",
      "durationSec": 2.976
    },
    {
      "index": 92,
      "text": "الزفير.",
      "file": "c092.ogg",
      "durationSec": 3.048
    },
    {
      "index": 93,
      "text": "استمر في هذا الشعور لبضعة أنفاس أخرى.",
      "file": "c093.ogg",
      "durationSec": 7.08
    },
    {
      "index": 94,
      "text": "الدفء. نعومة. كفاية.",
      "file": "c094.ogg",
      "durationSec": 7.896
    },
    {
      "index": 95,
      "text": "يمكنك العودة إلى هذا المكان عندما تحتاج إليه.",
      "file": "c095.ogg",
      "durationSec": 8.112
    },
    {
      "index": 96,
      "text": "إنه يعيش في انتباهك، وليس في خيالك فقط.",
      "file": "c096.ogg",
      "durationSec": 7.944
    },
    {
      "index": 97,
      "text": "البدء في تعميق التنفس.",
      "file": "c097.ogg",
      "durationSec": 5.136
    },
    {
      "index": 98,
      "text": "اشعر بالغرفة من حولك مرة أخرى.",
      "file": "c098.ogg",
      "durationSec": 6.624
    },
    {
      "index": 99,
      "text": "تذبذب الأصابع. تنعيم أصابع القدم.",
      "file": "c099.ogg",
      "durationSec": 8.184
    },
    {
      "index": 100,
      "text": "عندما تكون مستعدا، افتح عينيك.",
      "file": "c100.ogg",
      "durationSec": 7.032
    },
    {
      "index": 101,
      "text": "خذ نفسًا سهلاً آخر.",
      "file": "c101.ogg",
      "durationSec": 4.56
    },
    {
      "index": 102,
      "text": "احمل هذا الهدوء إلى كل ما يأتي بعد ذلك.",
      "file": "c102.ogg",
      "durationSec": 6.984
    }
  ]
}
