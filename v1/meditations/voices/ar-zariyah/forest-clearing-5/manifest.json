{
  "id": "forest-clearing-5",
  "voiceId": "ar-zariyah",
  "edgeVoice": "ar-SA-ZariyahNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 392,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "خذ مقعدًا مريحًا، أو استلقِ إذا كان ذلك أفضل.",
      "file": "c001.ogg",
      "durationSec": 8.52
    },
    {
      "index": 2,
      "text": "دع يديك ترتاح.",
      "file": "c002.ogg",
      "durationSec": 4.104
    },
    {
      "index": 3,
      "text": "اسمح لعينيك بإغلاق أو تخفيف نظرتك.",
      "file": "c003.ogg",
      "durationSec": 7.176
    },
    {
      "index": 4,
      "text": "لاحظ وزن جسمك الذي يحمله.",
      "file": "c004.ogg",
      "durationSec": 5.664
    },
    {
      "index": 5,
      "text": "خذ نفسا بطيئا من خلال الأنف.",
      "file": "c005.ogg",
      "durationSec": 5.664
    },
    {
      "index": 6,
      "text": "وزفير أطول وأسهل.",
      "file": "c006.ogg",
      "durationSec": 4.608
    },
    {
      "index": 7,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c007.ogg",
      "durationSec": 7.224
    },
    {
      "index": 8,
      "text": "زفير لطيف.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "إذا شردت الأفكار، فلا بأس. العودة إلى التنفس.",
      "file": "c009.ogg",
      "durationSec": 10.416
    },
    {
      "index": 10,
      "text": "الآن، تخيل مسارًا أسفل فضلات الأوراق الناعمة.",
      "file": "c010.ogg",
      "durationSec": 8.544
    },
    {
      "index": 11,
      "text": "أنت تمشي دون عجلة من أمرك في غابة هادئة.",
      "file": "c011.ogg",
      "durationSec": 7.728
    },
    {
      "index": 12,
      "text": "يتحرك الضوء المرقط عبر ساعديك.",
      "file": "c012.ogg",
      "durationSec": 6.456
    },
    {
      "index": 13,
      "text": "اشعري بدفء الشمس اللطيف أينما وجدت الجلد.",
      "file": "c013.ogg",
      "durationSec": 7.368
    },
    {
      "index": 14,
      "text": "نضارة باردة تركب النسيم بين الأشجار.",
      "file": "c014.ogg",
      "durationSec": 7.176
    },
    {
      "index": 15,
      "text": "رائحة الأرض الخضراء واللحاء والرطوبة المعدنية النظيفة.",
      "file": "c015.ogg",
      "durationSec": 9.0
    },
    {
      "index": 16,
      "text": "يفتح المسار في مساحة صغيرة.",
      "file": "c016.ogg",
      "durationSec": 5.904
    },
    {
      "index": 17,
      "text": "يسند الطحلب جذعًا ساقطًا. أنت تجلس.",
      "file": "c017.ogg",
      "durationSec": 8.664
    },
    {
      "index": 18,
      "text": "حمامات الشمس في المركز مثل الذهب الهادئ.",
      "file": "c018.ogg",
      "durationSec": 6.864
    },
    {
      "index": 19,
      "text": "اشعر بهذا الدفء على وجهك، بطيئًا ولطيفًا.",
      "file": "c019.ogg",
      "durationSec": 8.256
    },
    {
      "index": 20,
      "text": "النسيم يلمس شعرك ويبرد معابدك.",
      "file": "c020.ogg",
      "durationSec": 6.864
    },
    {
      "index": 21,
      "text": "تصل أصوات العصافير من بعيد، ثم تتلاشى.",
      "file": "c021.ogg",
      "durationSec": 7.752
    },
    {
      "index": 22,
      "text": "أنفاسك يطابق صمت الأوراق.",
      "file": "c022.ogg",
      "durationSec": 5.688
    },
    {
      "index": 23,
      "text": "يستنشق نضارة. زفر أي عجلة متبقية.",
      "file": "c023.ogg",
      "durationSec": 9.24
    },
    {
      "index": 24,
      "text": "لاحظ مدى أمان الأرض تحتك.",
      "file": "c024.ogg",
      "durationSec": 5.568
    },
    {
      "index": 25,
      "text": "مدى اتساع السماء فوق المظلة.",
      "file": "c025.ogg",
      "durationSec": 5.52
    },
    {
      "index": 26,
      "text": "تعبر الخنفساء رقعة من اللحاء مضاءة بنور الشمس ببطء.",
      "file": "c026.ogg",
      "durationSec": 9.696
    },
    {
      "index": 27,
      "text": "ليس لديك مكان لتكون فيه سوى هنا.",
      "file": "c027.ogg",
      "durationSec": 6.816
    },
    {
      "index": 28,
      "text": "يتجمع الدفء مرة أخرى على جفونك المغلقة.",
      "file": "c028.ogg",
      "durationSec": 7.896
    },
    {
      "index": 29,
      "text": "ينزلق الهواء البارد تحت طوقك مثل يد لطيفة.",
      "file": "c029.ogg",
      "durationSec": 8.088
    },
    {
      "index": 30,
      "text": "ابق مع الدفء على خديك.",
      "file": "c030.ogg",
      "durationSec": 4.992
    },
    {
      "index": 31,
      "text": "ابقِ مع الهواء البارد على شفتيك أثناء الزفير.",
      "file": "c031.ogg",
      "durationSec": 7.488
    },
    {
      "index": 32,
      "text": "هذا المقاصة لا يطلب شيئا. إنه يحملك ببساطة.",
      "file": "c032.ogg",
      "durationSec": 10.2
    },
    {
      "index": 33,
      "text": "دع نفسًا آخر ينتقل إلى البطن.",
      "file": "c033.ogg",
      "durationSec": 5.808
    },
    {
      "index": 34,
      "text": "وتترك مرة أخرى ناعمة كالأوراق.",
      "file": "c034.ogg",
      "durationSec": 6.84
    },
    {
      "index": 35,
      "text": "تجول انتباهك ببطء حول حافة المقاصة.",
      "file": "c035.ogg",
      "durationSec": 7.248
    },
    {
      "index": 36,
      "text": "السرخس. الظل. فطر شاحب عند قاعدة الجذع.",
      "file": "c036.ogg",
      "durationSec": 11.136
    },
    {
      "index": 37,
      "text": "كل شيء حيوي لأنك لا تتعجل.",
      "file": "c037.ogg",
      "durationSec": 6.528
    },
    {
      "index": 38,
      "text": "اشعر بدفء الشمس مرة أخرى حيث تهبط على الركبة.",
      "file": "c038.ogg",
      "durationSec": 8.4
    },
    {
      "index": 39,
      "text": "اشعر ببرودة النسيم حيث ينزلق عبر الحلق.",
      "file": "c039.ogg",
      "durationSec": 7.584
    },
    {
      "index": 40,
      "text": "يمكنك البقاء هنا طوال فترة ما بعد الظهر. في الوقت الحالي، بضعة أنفاس كافية.",
      "file": "c040.ogg",
      "durationSec": 14.184
    },
    {
      "index": 41,
      "text": "الآن استرح في أنفاسك وحدك لبعض الوقت.",
      "file": "c041.ogg",
      "durationSec": 6.984
    },
    {
      "index": 42,
      "text": "يستنشق ببطء.",
      "file": "c042.ogg",
      "durationSec": 3.96
    },
    {
      "index": 43,
      "text": "الزفير ببطء.",
      "file": "c043.ogg",
      "durationSec": 3.648
    },
    {
      "index": 44,
      "text": "يستنشق.",
      "file": "c044.ogg",
      "durationSec": 2.976
    },
    {
      "index": 45,
      "text": "الزفير.",
      "file": "c045.ogg",
      "durationSec": 3.048
    },
    {
      "index": 46,
      "text": "اشعر بالدفء أينما كان الجسم دافئًا.",
      "file": "c046.ogg",
      "durationSec": 6.624
    },
    {
      "index": 47,
      "text": "اشعر بالبرودة أينما كان الهواء باردًا.",
      "file": "c047.ogg",
      "durationSec": 7.032
    },
    {
      "index": 48,
      "text": "يستنشق.",
      "file": "c048.ogg",
      "durationSec": 2.976
    },
    {
      "index": 49,
      "text": "الزفير.",
      "file": "c049.ogg",
      "durationSec": 3.048
    },
    {
      "index": 50,
      "text": "لا مكان للذهاب. لا شيء لإصلاحه.",
      "file": "c050.ogg",
      "durationSec": 8.184
    },
    {
      "index": 51,
      "text": "يستنشق.",
      "file": "c051.ogg",
      "durationSec": 2.976
    },
    {
      "index": 52,
      "text": "الزفير.",
      "file": "c052.ogg",
      "durationSec": 3.048
    },
    {
      "index": 53,
      "text": "استرح هنا لبضع أنفاس هادئة.",
      "file": "c053.ogg",
      "durationSec": 5.856
    },
    {
      "index": 54,
      "text": "اعلم أنه يمكنك العودة إلى هذا المكان في أي وقت.",
      "file": "c054.ogg",
      "durationSec": 8.184
    },
    {
      "index": 55,
      "text": "عندما تكون مستعدًا، قم بتعميق أنفاسك.",
      "file": "c055.ogg",
      "durationSec": 7.92
    },
    {
      "index": 56,
      "text": "تذبذب أصابع اليدين والقدمين.",
      "file": "c056.ogg",
      "durationSec": 6.0
    },
    {
      "index": 57,
      "text": "افتح عينيك بهدوء.",
      "file": "c057.ogg",
      "durationSec": 4.56
    },
    {
      "index": 58,
      "text": "احمل القليل من هذا السلام معك.",
      "file": "c058.ogg",
      "durationSec": 5.712
    }
  ]
}
