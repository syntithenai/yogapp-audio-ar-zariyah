    {
      "index": 10,
      "text": "يستنشق عن طريق الأنف.",
      "file": "c010.ogg",
      "durationSec": 4.8
    },
    {
      "index": 11,
      "text": "الزفير من خلال الفم، كما لو كان تعفير النافذة.",
