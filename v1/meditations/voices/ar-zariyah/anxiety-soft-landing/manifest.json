  "totalSec": 173,
  "chunks": [
    {
      "index": 0,
      "text": "إذا شعرت بالنشاط أو القلق، فمرحبًا بك هنا.",
      "file": "c000.ogg",
      "durationSec": 8.112
    },
    {
      "index": 1,
      "text": "لا تحتاج إلى الشعور بالهدوء بعد.",
      "file": "c001.ogg",
      "durationSec": 6.144
    },
    {
      "index": 2,
      "text": "فقط اتبع على طول.",
      "file": "c002.ogg",
      "durationSec": 4.464
    },
    {
      "index": 3,
      "text": "زرع كلا القدمين على الأرض إذا استطعت.",
      "file": "c003.ogg",
      "durationSec": 6.552
    },
    {
      "index": 4,
      "text": "اشعر بالاتصال. الكعب. كرات القدمين. أصابع القدم.",
      "file": "c004.ogg",
      "durationSec": 14.016
    },
    {
      "index": 5,
      "text": "اضغط لأسفل بلطف. لاحظ الدفع للخلف من الأرض.",
      "file": "c005.ogg",
      "durationSec": 9.648
    },
    {
      "index": 6,
      "text": "اذكر خمسة أشياء يمكنك رؤيتها.",
      "file": "c006.ogg",
      "durationSec": 6.312
    },
    {
      "index": 7,
      "text": "بهدوء. لا اندفاع.",
      "file": "c007.ogg",
      "durationSec": 6.192
    },
    {
      "index": 8,
      "text": "اذكر أربعة أشياء يمكنك لمسها.",
      "file": "c008.ogg",
      "durationSec": 6.216
    },
    {
      "index": 9,
      "text": "ملابس. كرسي. الهواء على الجلد.",
      "file": "c009.ogg",
      "durationSec": 9.552
    },
    {
      "index": 10,
      "text": "اذكر ثلاثة أصوات، قريبة أو بعيدة.",
      "file": "c010.ogg",
      "durationSec": 7.488
    },
    {
      "index": 11,
      "text": "قم بتسمية رائحتين، أو لاحظ الهواء ببساطة.",
      "file": "c011.ogg",
      "durationSec": 8.448
    },
    {
      "index": 12,
      "text": "اذكر طعمًا واحدًا، أو الشعور الذي تشعر به في الفم.",
      "file": "c012.ogg",
      "durationSec": 9.12
    },
    {
      "index": 13,
      "text": "أنت هنا. في هذا الجسد. في هذه الغرفة.",
      "file": "c013.ogg",
      "durationSec": 10.392
    },
    {
      "index": 14,
      "text": "الآن تنفس لمدة أربعة.",
      "file": "c014.ogg",
      "durationSec": 5.592
    },
    {
      "index": 15,
      "text": "عقد بهدوء لمدة سنتين.",
      "file": "c015.ogg",
      "durationSec": 5.976
    },
    {
      "index": 16,
      "text": "خارج لمدة ستة.",
      "file": "c016.ogg",
      "durationSec": 4.32
    },
    {
      "index": 17,
      "text": "مرة أخرى إذا أردت.",
      "file": "c017.ogg",
      "durationSec": 4.728
    },
    {
      "index": 18,
      "text": "ضع يدك على الصدر أو البطن.",
      "file": "c018.ogg",
      "durationSec": 5.16
    },
    {
      "index": 19,
      "text": "اشعر بالحركة تحت يدك.",
      "file": "c019.ogg",
      "durationSec": 5.184
    },
    {
      "index": 20,
      "text": "ربما لا يزال القلق موجودًا. هذا مسموح.",
      "file": "c020.ogg",
      "durationSec": 9.216
    },
    {
      "index": 21,
      "text": "لقد منحت الجهاز العصبي هبوطًا أكثر ليونة.",
      "file": "c021.ogg",
      "durationSec": 7.512
    },
    {
      "index": 22,
      "text": "خذ نفسًا آخر.",
      "file": "c022.ogg",
      "durationSec": 3.888
    },
    {
      "index": 23,
      "text": "عندما تصبح جاهزًا، افتح عينيك واستمر في يومك.",
      "file": "c023.ogg",
      "durationSec": 9.0
    }
  ]
}
