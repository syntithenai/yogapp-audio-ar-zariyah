{
  "id": "lakeside-dawn-5",
  "voiceId": "ar-zariyah",
  "edgeVoice": "ar-SA-ZariyahNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 412,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "خذ مقعدًا مريحًا، أو استلقِ إذا كان ذلك أفضل.",
      "file": "c001.ogg",
      "durationSec": 8.52
    },
    {
      "index": 2,
      "text": "دع يديك ترتاح.",
      "file": "c002.ogg",
      "durationSec": 4.104
    },
    {
      "index": 3,
      "text": "اسمح لعينيك بإغلاق أو تخفيف نظرتك.",
      "file": "c003.ogg",
      "durationSec": 7.176
    },
    {
      "index": 4,
      "text": "لاحظ وزن جسمك الذي يحمله.",
      "file": "c004.ogg",
      "durationSec": 5.664
    },
    {
      "index": 5,
      "text": "خذ نفسا بطيئا من خلال الأنف.",
      "file": "c005.ogg",
      "durationSec": 5.664
    },
    {
      "index": 6,
      "text": "وزفير أطول وأسهل.",
      "file": "c006.ogg",
      "durationSec": 4.608
    },
    {
      "index": 7,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c007.ogg",
      "durationSec": 7.224
    },
    {
      "index": 8,
      "text": "زفير لطيف.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "إذا شردت الأفكار، فلا بأس. العودة إلى التنفس.",
      "file": "c009.ogg",
      "durationSec": 10.416
    },
    {
      "index": 10,
      "text": "تصور نفسك على حافة بحيرة ساكنة عند الفجر.",
      "file": "c010.ogg",
      "durationSec": 8.424
    },
    {
      "index": 11,
      "text": "الماء يحمل سماء فضية شاحبة.",
      "file": "c011.ogg",
      "durationSec": 6.504
    },
    {
      "index": 12,
      "text": "الهواء البارد ينظف خدودك بنضارة نظيفة.",
      "file": "c012.ogg",
      "durationSec": 8.04
    },
    {
      "index": 13,
      "text": "يبدأ شريط ناعم من الشمس في تدفئة كتفيك.",
      "file": "c013.ogg",
      "durationSec": 8.496
    },
    {
      "index": 14,
      "text": "اشعر بهذا الدفء ينتشر ببطء عبر ظهرك.",
      "file": "c014.ogg",
      "durationSec": 7.2
    },
    {
      "index": 15,
      "text": "أنت خطوة أقرب. الرمال الناعمة تعطي تحت قدميك.",
      "file": "c015.ogg",
      "durationSec": 10.248
    },
    {
      "index": 16,
      "text": "اغمس أطراف أصابعك في الماء. رائع. واضح.",
      "file": "c016.ogg",
      "durationSec": 10.92
    },
    {
      "index": 17,
      "text": "تنتقل التموجات إلى الخارج وتختفي.",
      "file": "c017.ogg",
      "durationSec": 6.888
    },
    {
      "index": 18,
      "text": "نسيم تفوح منه رائحة النباتات المائية والصباح.",
      "file": "c018.ogg",
      "durationSec": 8.472
    },
    {
      "index": 19,
      "text": "يستمع. لا شيء تقريبا. طائر بعيد. أنفاسك الخاصة.",
      "file": "c019.ogg",
      "durationSec": 14.28
    },
    {
      "index": 20,
      "text": "اجلس على حجر أملس يدفئه الضوء المتصاعد بدرجة كافية.",
      "file": "c020.ogg",
      "durationSec": 9.648
    },
    {
      "index": 21,
      "text": "اشعر بحرارة الحجر الهادئة تحتك.",
      "file": "c021.ogg",
      "durationSec": 6.336
    },
    {
      "index": 22,
      "text": "اشعر بنضارة الهواء الذي يدخل إلى رئتيك.",
      "file": "c022.ogg",
      "durationSec": 7.44
    },
    {
      "index": 23,
      "text": "تعكس البحيرة اللون الوردي الناعم والذهبي.",
      "file": "c023.ogg",
      "durationSec": 7.392
    },
    {
      "index": 24,
      "text": "تشاهد الضوء يتحرك عبر السطح مثل التنفس البطيء.",
      "file": "c024.ogg",
      "durationSec": 8.328
    },
    {
      "index": 25,
      "text": "ترتفع السمكة، وتتسع الحلقات، ثم تعود المرآة.",
      "file": "c025.ogg",
      "durationSec": 9.792
    },
    {
      "index": 26,
      "text": "الدفء على جفونك المغلقة.",
      "file": "c026.ogg",
      "durationSec": 5.472
    },
    {
      "index": 27,
      "text": "البرودة على ظهر يديك.",
      "file": "c027.ogg",
      "durationSec": 5.112
    },
    {
      "index": 28,
      "text": "في مكان ما بعيدًا، اصطدم حبل القارب بالخشب مرة واحدة.",
      "file": "c028.ogg",
      "durationSec": 10.08
    },
    {
      "index": 29,
      "text": "ثم صمت مرة أخرى، واسعًا ولطيفًا.",
      "file": "c029.ogg",
      "durationSec": 7.704
    },
    {
      "index": 30,
      "text": "استنشق الصباح البارد. الزفير في الماء المفتوح.",
      "file": "c030.ogg",
      "durationSec": 9.072
    },
    {
      "index": 31,
      "text": "يستقر السلام بالطريقة التي يرتفع بها الضباب من الماء - بلطف، تمامًا.",
      "file": "c031.ogg",
      "durationSec": 11.544
    },
    {
      "index": 32,
      "text": "يُسمح لك بشغل مساحة في هذا الهدوء.",
      "file": "c032.ogg",
      "durationSec": 6.84
    },
    {
      "index": 33,
      "text": "نفس آخر يتذوق الفجر.",
      "file": "c033.ogg",
      "durationSec": 5.496
    },
    {
      "index": 34,
      "text": "انظر مرة أخرى إلى المسار الفضي للضوء على الماء.",
      "file": "c034.ogg",
      "durationSec": 8.136
    },
    {
      "index": 35,
      "text": "اتبعه بعيون ناعمة نحو الشاطئ البعيد.",
      "file": "c035.ogg",
      "durationSec": 7.392
    },
    {
      "index": 36,
      "text": "الأشجار هناك زرقاء مع المسافة وضباب الصباح.",
      "file": "c036.ogg",
      "durationSec": 7.992
    },
    {
      "index": 37,
      "text": "ينمو الدفء قليلاً على كتفيك مع صعود الشمس.",
      "file": "c037.ogg",
      "durationSec": 7.68
    },
    {
      "index": 38,
      "text": "يبقى النسيم منعشًا ونظيفًا وناشئًا عن البحيرة.",
      "file": "c038.ogg",
      "durationSec": 8.112
    },
    {
      "index": 39,
      "text": "دع تلك النضارة تغسل العقل بنفس الطريقة التي يشطف بها الضوء السطح.",
      "file": "c039.ogg",
      "durationSec": 10.56
    },
    {
      "index": 40,
      "text": "اجلس لثلاثة أنفاس إضافية من الدفء والهواء البارد معًا.",
      "file": "c040.ogg",
      "durationSec": 9.672
    },
    {
      "index": 41,
      "text": "الآن استرح في أنفاسك وحدك لبعض الوقت.",
      "file": "c041.ogg",
      "durationSec": 6.984
    },
    {
      "index": 42,
      "text": "يستنشق ببطء.",
      "file": "c042.ogg",
      "durationSec": 3.96
    },
    {
      "index": 43,
      "text": "الزفير ببطء.",
      "file": "c043.ogg",
      "durationSec": 3.648
    },
    {
      "index": 44,
      "text": "يستنشق.",
      "file": "c044.ogg",
      "durationSec": 2.976
    },
    {
      "index": 45,
      "text": "الزفير.",
      "file": "c045.ogg",
      "durationSec": 3.048
    },
    {
      "index": 46,
      "text": "اشعر بالدفء أينما كان الجسم دافئًا.",
      "file": "c046.ogg",
      "durationSec": 6.624
    },
    {
      "index": 47,
      "text": "اشعر بالبرودة أينما كان الهواء باردًا.",
      "file": "c047.ogg",
      "durationSec": 7.032
    },
    {
      "index": 48,
      "text": "يستنشق.",
      "file": "c048.ogg",
      "durationSec": 2.976
    },
    {
      "index": 49,
      "text": "الزفير.",
      "file": "c049.ogg",
      "durationSec": 3.048
    },
    {
      "index": 50,
      "text": "لا مكان للذهاب. لا شيء لإصلاحه.",
      "file": "c050.ogg",
      "durationSec": 8.184
    },
    {
      "index": 51,
      "text": "يستنشق.",
      "file": "c051.ogg",
      "durationSec": 2.976
    },
    {
      "index": 52,
      "text": "الزفير.",
      "file": "c052.ogg",
      "durationSec": 3.048
    },
    {
      "index": 53,
      "text": "استرح هنا لبضع أنفاس هادئة.",
      "file": "c053.ogg",
      "durationSec": 5.856
    },
    {
      "index": 54,
      "text": "اعلم أنه يمكنك العودة إلى هذا المكان في أي وقت.",
      "file": "c054.ogg",
      "durationSec": 8.184
    },
    {
      "index": 55,
      "text": "عندما تكون مستعدًا، قم بتعميق أنفاسك.",
      "file": "c055.ogg",
      "durationSec": 7.92
    },
    {
      "index": 56,
      "text": "تذبذب أصابع اليدين والقدمين.",
      "file": "c056.ogg",
      "durationSec": 6.0
    },
    {
      "index": 57,
      "text": "افتح عينيك بهدوء.",
      "file": "c057.ogg",
      "durationSec": 4.56
    },
    {
      "index": 58,
      "text": "احمل القليل من هذا السلام معك.",
      "file": "c058.ogg",
      "durationSec": 5.712
    }
  ]
}
