      "text": "[وقفة: 37]",
      "file": "c018.ogg",
      "durationSec": 5.472
    },
    {
      "index": 19,
      "text": "إذا نشأت العاطفة، دعها تتحرك مثل الطقس.",
      "file": "c019.ogg",
