  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 228,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "خذ وقتا للوصول.",
      "file": "c001.ogg",
      "durationSec": 4.32
    },
    {
      "index": 2,
      "text": "الجلوس أو الاستلقاء مع الدعم.",
      "file": "c002.ogg",
      "durationSec": 5.832
    },
    {
      "index": 3,
      "text": "أغمض عينيك إذا كان ذلك آمنًا.",
      "file": "c003.ogg",
      "durationSec": 6.432
    },
    {
      "index": 4,
      "text": "يشعر الاتصال مع الأرض.",
      "file": "c004.ogg",
      "durationSec": 4.704
    },
    {
      "index": 5,
      "text": "التنفس البطيء.",
      "file": "c005.ogg",
      "durationSec": 3.96
    },
    {
      "index": 6,
      "text": "زفير أطول.",
      "file": "c006.ogg",
      "durationSec": 3.744
    },
    {
      "index": 7,
      "text": "[وقفة: 26]",
      "file": "c007.ogg",
      "durationSec": 5.232
    },
    {
      "index": 8,
      "text": "مرة أخرى.",
      "file": "c008.ogg",
      "durationSec": 3.672
    },
    {
      "index": 9,
      "text": "[وقفة: 26]",
      "file": "c009.ogg",
      "durationSec": 5.232
    },
    {
      "index": 10,
      "text": "دع الكتفين تنخفض.",
      "file": "c010.ogg",
      "durationSec": 4.752
    },
    {
      "index": 11,
      "text": "دع البطن يلين.",
      "file": "c011.ogg",
      "durationSec": 3.984
    },
    {
      "index": 12,
      "text": "[وقفة: 32]",
      "file": "c012.ogg",
      "durationSec": 5.784
    },
    {
      "index": 13,
      "text": "اليد على القلب، إذا كان ذلك يساعد.",
      "file": "c013.ogg",
      "durationSec": 7.08
    },
    {
      "index": 14,
      "text": "لاحظ حالتك دون حكم.",
      "file": "c014.ogg",
      "durationSec": 5.04
    },
    {
      "index": 15,
      "text": "[وقفة: 32]",
      "file": "c015.ogg",
      "durationSec": 5.784
    },
    {
      "index": 16,
      "text": "هذه لحظة معاناة، أو لحظة إجهاد إنساني عادي.",
      "file": "c016.ogg",
      "durationSec": 9.312
    },
    {
      "index": 17,
      "text": "يشعر الآخرون بهذا أيضًا.",
      "file": "c017.ogg",
      "durationSec": 5.424
    },
    {
      "index": 18,
      "text": "[وقفة: 39]",
      "file": "c018.ogg",
      "durationSec": 5.496
    },
    {
      "index": 19,
      "text": "هل لي أن أكون لطيفًا مع نفسي في هذه اللحظة.",
      "file": "c019.ogg",
      "durationSec": 7.152
    },
    {
      "index": 20,
      "text": "[وقفة: 32]",
      "file": "c020.ogg",
      "durationSec": 5.784
    },
    {
      "index": 21,
      "text": "هل لي أن أتقبل نفسي كما أنا؟",
      "file": "c021.ogg",
      "durationSec": 5.568
    },
    {
      "index": 22,
      "text": "[وقفة: 32]",
      "file": "c022.ogg",
      "durationSec": 5.784
    },
    {
      "index": 23,
      "text": "هل يمكنني أن أعطي نفسي التعاطف الذي أحتاجه؟",
      "file": "c023.ogg",
      "durationSec": 7.752
    },
    {
      "index": 24,
      "text": "[وقفة: 39]",
      "file": "c024.ogg",
      "durationSec": 5.496
    },
    {
      "index": 25,
      "text": "كرر العبارات التي تهبط. اترك تلك التي لا تفعل ذلك.",
      "file": "c025.ogg",
      "durationSec": 10.632
    },
    {
      "index": 26,
      "text": "[وقفة: 52]",
      "file": "c026.ogg",
      "durationSec": 5.592
    },
    {
      "index": 27,
      "text": "تخيل أنك تتحدث إلى نفسك كما يفعل صديق حكيم.",
      "file": "c027.ogg",
      "durationSec": 9.216
    },
    {
      "index": 28,
      "text": "ما هي النغمة التي سيستخدمونها؟",
      "file": "c028.ogg",
      "durationSec": 6.048
    },
    {
      "index": 29,
      "text": "تقدم لنفسك تلك النغمة الآن.",
      "file": "c029.ogg",
      "durationSec": 6.024
    },
    {
      "index": 30,
      "text": "[وقفة:65]",
      "file": "c030.ogg",
      "durationSec": 5.208
    },
    {
      "index": 31,
      "text": "تنفس اللطف في.",
      "file": "c031.ogg",
      "durationSec": 3.864
    },
    {
      "index": 32,
      "text": "تنفس بقسوة.",
      "file": "c032.ogg",
      "durationSec": 4.08
    },
    {
      "index": 33,
      "text": "[وقفة: 78]",
      "file": "c033.ogg",
      "durationSec": 5.448
    },
    {
      "index": 34,
      "text": "[وقفة: 39]",
      "file": "c034.ogg",
      "durationSec": 5.496
    },
    {
      "index": 35,
      "text": "البدء في تعميق التنفس.",
      "file": "c035.ogg",
      "durationSec": 5.136
    },
    {
      "index": 36,
      "text": "اشعر بالغرفة مرة أخرى.",
      "file": "c036.ogg",
      "durationSec": 5.352
    },
    {
      "index": 37,
      "text": "تذبذب أصابع اليدين والقدمين.",
      "file": "c037.ogg",
      "durationSec": 6.0
    },
    {
      "index": 38,
      "text": "عندما تصبح جاهزة، افتح عينيك.",
      "file": "c038.ogg",
      "durationSec": 6.84
    },
    {
      "index": 39,
      "text": "التحرك ببطء إلى ما سيأتي بعد ذلك.",
      "file": "c039.ogg",
      "durationSec": 6.888
    }
  ]
}
