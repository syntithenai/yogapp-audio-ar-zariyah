{
  "id": "cove-shore-5",
  "voiceId": "ar-zariyah",
  "edgeVoice": "ar-SA-ZariyahNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 392,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "خذ مقعدًا مريحًا، أو استلقِ إذا كان ذلك أفضل.",
      "file": "c001.ogg",
      "durationSec": 8.52
    },
    {
      "index": 2,
      "text": "دع يديك ترتاح.",
      "file": "c002.ogg",
      "durationSec": 4.104
    },
    {
      "index": 3,
      "text": "اسمح لعينيك بإغلاق أو تخفيف نظرتك.",
      "file": "c003.ogg",
      "durationSec": 7.176
    },
    {
      "index": 4,
      "text": "لاحظ وزن جسمك الذي يحمله.",
      "file": "c004.ogg",
      "durationSec": 5.664
    },
    {
      "index": 5,
      "text": "خذ نفسا بطيئا من خلال الأنف.",
      "file": "c005.ogg",
      "durationSec": 5.664
    },
    {
      "index": 6,
      "text": "وزفير أطول وأسهل.",
      "file": "c006.ogg",
      "durationSec": 4.608
    },
    {
      "index": 7,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c007.ogg",
      "durationSec": 7.224
    },
    {
      "index": 8,
      "text": "زفير لطيف.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "إذا شردت الأفكار، فلا بأس. العودة إلى التنفس.",
      "file": "c009.ogg",
      "durationSec": 10.416
    },
    {
      "index": 10,
      "text": "ترى نفسك تصل إلى خليج صغير محمي.",
      "file": "c010.ogg",
      "durationSec": 6.936
    },
    {
      "index": 11,
      "text": "منحنى المنحدرات حول الرمال الناعمة الشاحبة.",
      "file": "c011.ogg",
      "durationSec": 7.272
    },
    {
      "index": 12,
      "text": "يتحرك البحر بأمواج منخفضة صابرة.",
      "file": "c012.ogg",
      "durationSec": 7.08
    },
    {
      "index": 13,
      "text": "شمس خفيفة تدفئ قمم كتفيك.",
      "file": "c013.ogg",
      "durationSec": 6.72
    },
    {
      "index": 14,
      "text": "النسيم المالح يبرد شفتيك وجفونك.",
      "file": "c014.ogg",
      "durationSec": 7.008
    },
    {
      "index": 15,
      "text": "اشعر بنضارة ذلك الهواء الذي يملأ صدرك.",
      "file": "c015.ogg",
      "durationSec": 7.464
    },
    {
      "index": 16,
      "text": "المشي إلى خط الماء. الرمال الرطبة تعانق قدميك.",
      "file": "c016.ogg",
      "durationSec": 10.2
    },
    {
      "index": 17,
      "text": "تلامس الرغوة الباردة كاحليك وتنزلق بعيدًا.",
      "file": "c017.ogg",
      "durationSec": 7.944
    },
    {
      "index": 18,
      "text": "الإيقاع بسيط. يصل. تليين. يترك.",
      "file": "c018.ogg",
      "durationSec": 12.144
    },
    {
      "index": 19,
      "text": "اجلس حيث الرمال الجافة دافئة تحتك.",
      "file": "c019.ogg",
      "durationSec": 6.624
    },
    {
      "index": 20,
      "text": "استند إلى يديك. اشعر بالحرارة المحببة.",
      "file": "c020.ogg",
      "durationSec": 9.24
    },
    {
      "index": 21,
      "text": "استمع إلى صمت واندفاع الخليج.",
      "file": "c021.ogg",
      "durationSec": 5.976
    },
    {
      "index": 22,
      "text": "شم الملح والشمس والحجر النظيف.",
      "file": "c022.ogg",
      "durationSec": 6.096
    },
    {
      "index": 23,
      "text": "الدفء على بشرتك. البرودة في كل شهيق.",
      "file": "c023.ogg",
      "durationSec": 8.88
    },
    {
      "index": 24,
      "text": "بعيدًا، يتلألأ الضوء مثل الضحك الهادئ.",
      "file": "c024.ogg",
      "durationSec": 7.32
    },
    {
      "index": 25,
      "text": "لا تحتاج لمطاردته. إنه هنا بالفعل.",
      "file": "c025.ogg",
      "durationSec": 8.784
    },
    {
      "index": 26,
      "text": "تصل الموجة أبعد، وتبرد أصابع قدميك، ثم تتراجع.",
      "file": "c026.ogg",
      "durationSec": 10.248
    },
    {
      "index": 27,
      "text": "الرمال الدافئة تستعيد قدميك.",
      "file": "c027.ogg",
      "durationSec": 5.928
    },
    {
      "index": 28,
      "text": "دع أنفاسك تتحرك مع الأمواج - ببطء للداخل، للخارج لفترة أطول.",
      "file": "c028.ogg",
      "durationSec": 12.288
    },
    {
      "index": 29,
      "text": "السلام هو الخليج نفسه. أنت بداخله.",
      "file": "c029.ogg",
      "durationSec": 8.208
    },
    {
      "index": 30,
      "text": "ركز انتباهك على الدفء بين لوحي كتفك.",
      "file": "c030.ogg",
      "durationSec": 7.296
    },
    {
      "index": 31,
      "text": "وعلى الهواء المالح النقي عند طرف الأنف.",
      "file": "c031.ogg",
      "durationSec": 6.696
    },
    {
      "index": 32,
      "text": "تتبع خط الجرف بخيال ناعم.",
      "file": "c032.ogg",
      "durationSec": 6.216
    },
    {
      "index": 33,
      "text": "تحسنت الحجر يوما بعد يوم. الظل بارد في الطيات.",
      "file": "c033.ogg",
      "durationSec": 10.272
    },
    {
      "index": 34,
      "text": "يحتوي حوض المد والجزر القريب على عالم صغير واضح.",
      "file": "c034.ogg",
      "durationSec": 8.76
    },
    {
      "index": 35,
      "text": "لا تحتاج إلى الاتكاء. معرفة أن هناك ما يكفي.",
      "file": "c035.ogg",
      "durationSec": 9.816
    },
    {
      "index": 36,
      "text": "موجة أخرى. كاحلين باردين. الرمال الدافئة. نفسا ناعما.",
      "file": "c036.ogg",
      "durationSec": 14.808
    },
    {
      "index": 37,
      "text": "يستمر الخليج في تقديم نفس اللطف البسيط.",
      "file": "c037.ogg",
      "durationSec": 6.936
    },
    {
      "index": 38,
      "text": "احصل عليها مرة أخرى قبل أن تغادر.",
      "file": "c038.ogg",
      "durationSec": 6.696
    },
    {
      "index": 39,
      "text": "الآن استرح في أنفاسك وحدك لبعض الوقت.",
      "file": "c039.ogg",
      "durationSec": 6.984
    },
    {
      "index": 40,
      "text": "يستنشق ببطء.",
      "file": "c040.ogg",
      "durationSec": 3.96
    },
    {
      "index": 41,
      "text": "الزفير ببطء.",
      "file": "c041.ogg",
      "durationSec": 3.648
    },
    {
      "index": 42,
      "text": "يستنشق.",
      "file": "c042.ogg",
      "durationSec": 2.976
    },
    {
      "index": 43,
      "text": "الزفير.",
      "file": "c043.ogg",
      "durationSec": 3.048
    },
    {
      "index": 44,
      "text": "اشعر بالدفء أينما كان الجسم دافئًا.",
      "file": "c044.ogg",
      "durationSec": 6.624
    },
    {
      "index": 45,
      "text": "اشعر بالبرودة أينما كان الهواء باردًا.",
      "file": "c045.ogg",
      "durationSec": 7.032
    },
    {
      "index": 46,
      "text": "يستنشق.",
      "file": "c046.ogg",
      "durationSec": 2.976
    },
    {
      "index": 47,
      "text": "الزفير.",
      "file": "c047.ogg",
      "durationSec": 3.048
    },
    {
      "index": 48,
      "text": "لا مكان للذهاب. لا شيء لإصلاحه.",
      "file": "c048.ogg",
      "durationSec": 8.184
    },
    {
      "index": 49,
      "text": "يستنشق.",
      "file": "c049.ogg",
      "durationSec": 2.976
    },
    {
      "index": 50,
      "text": "الزفير.",
      "file": "c050.ogg",
      "durationSec": 3.048
    },
    {
      "index": 51,
      "text": "استرح هنا لبضع أنفاس هادئة.",
      "file": "c051.ogg",
      "durationSec": 5.856
    },
    {
      "index": 52,
      "text": "اعلم أنه يمكنك العودة إلى هذا المكان في أي وقت.",
      "file": "c052.ogg",
      "durationSec": 8.184
    },
    {
      "index": 53,
      "text": "عندما تكون مستعدًا، قم بتعميق أنفاسك.",
      "file": "c053.ogg",
      "durationSec": 7.92
    },
    {
      "index": 54,
      "text": "تذبذب أصابع اليدين والقدمين.",
      "file": "c054.ogg",
      "durationSec": 6.0
    },
    {
      "index": 55,
      "text": "افتح عينيك بهدوء.",
      "file": "c055.ogg",
      "durationSec": 4.56
    },
    {
      "index": 56,
      "text": "احمل القليل من هذا السلام معك.",
      "file": "c056.ogg",
      "durationSec": 5.712
    }
  ]
}
