  "totalSec": 146,
  "chunks": [
    {
      "index": 0,
      "text": "استقر في وضعية ثابتة.",
      "file": "c000.ogg",
      "durationSec": 5.328
    },
    {
      "index": 1,
      "text": "العمود الفقري طويل ولكن ليس جامدًا.",
      "file": "c001.ogg",
      "durationSec": 7.272
    },
    {
      "index": 2,
      "text": "لفت الانتباه إلى التنفس كما هو بالفعل.",
      "file": "c002.ogg",
      "durationSec": 7.128
    },
    {
      "index": 3,
      "text": "لا تغيره بعد. فقط شاهد.",
      "file": "c003.ogg",
      "durationSec": 7.44
    },
    {
      "index": 4,
      "text": "اشعر ببرودة الشهيق عند فتحتي الأنف.",
      "file": "c004.ogg",
      "durationSec": 6.744
    },
    {
      "index": 5,
      "text": "اشعر بدفء الزفير.",
      "file": "c005.ogg",
      "durationSec": 4.44
    },
    {
      "index": 6,
      "text": "أو ملاحظة صعود وهبوط البطن.",
      "file": "c006.ogg",
      "durationSec": 6.0
    },
    {
      "index": 7,
      "text": "اختر مكانًا واحدًا لراحة انتباهك.",
      "file": "c007.ogg",
      "durationSec": 6.336
    },
    {
      "index": 8,
      "text": "عندما يتجول العقل، يرجى العودة.",
      "file": "c008.ogg",
      "durationSec": 6.576
    },
    {
      "index": 9,
      "text": "لا حكم. مجرد العودة.",
      "file": "c009.ogg",
      "durationSec": 6.552
    },
    {
      "index": 10,
      "text": "الآن، إذا كان الأمر سهلاً، قم بعد الدورات الخفيفة.",
      "file": "c010.ogg",
      "durationSec": 9.12
    },
    {
      "index": 11,
      "text": "يستنشق. واحد.",
      "file": "c011.ogg",
      "durationSec": 5.304
    },
    {
      "index": 12,
      "text": "الزفير. واحد.",
      "file": "c012.ogg",
      "durationSec": 5.376
    },
    {
      "index": 13,
      "text": "يستنشق. اثنين.",
      "file": "c013.ogg",
      "durationSec": 5.712
    },
    {
      "index": 14,
      "text": "الزفير. اثنين.",
      "file": "c014.ogg",
      "durationSec": 5.784
    },
    {
      "index": 15,
      "text": "استمر حتى الخامسة، ثم ابدأ مرة أخرى عند الواحدة.",
      "file": "c015.ogg",
      "durationSec": 8.976
    },
    {
      "index": 16,
      "text": "إذا فقدت العد، ابدأ من جديد بلطف.",
      "file": "c016.ogg",
      "durationSec": 6.888
    },
    {
      "index": 17,
      "text": "العودة هي الممارسة.",
      "file": "c017.ogg",
      "durationSec": 4.68
    },
    {
      "index": 18,
      "text": "دع التنفس يكون طبيعيا. لا سلالة.",
      "file": "c018.ogg",
      "durationSec": 8.544
    },
    {
      "index": 19,
      "text": "بضع دورات أخرى في صمت.",
      "file": "c019.ogg",
      "durationSec": 5.16
    },
    {
      "index": 20,
      "text": "الافراج عن العد.",
      "file": "c020.ogg",
      "durationSec": 4.128
    },
    {
      "index": 21,
      "text": "استرح في الوعي المفتوح للحظة.",
      "file": "c021.ogg",
      "durationSec": 5.4
    },
    {
      "index": 22,
      "text": "عندما تكون جاهزًا، افتح عينيك.",
      "file": "c022.ogg",
      "durationSec": 6.72
    }
  ]
}
