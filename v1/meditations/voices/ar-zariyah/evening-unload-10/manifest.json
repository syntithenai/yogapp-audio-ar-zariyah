      "text": "البدء في تعميق التنفس.",
      "file": "c033.ogg",
      "durationSec": 5.136
    },
    {
      "index": 34,
      "text": "اشعر بالغرفة مرة أخرى.",
      "file": "c034.ogg",
      "durationSec": 5.352
