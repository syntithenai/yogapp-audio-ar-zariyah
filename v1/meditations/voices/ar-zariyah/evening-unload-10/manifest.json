    },
    {
      "index": 13,
      "text": "دع اليوم ينتهي في الوقت الحالي.",
      "file": "c013.ogg",
      "durationSec": 5.568
    },
    {
      "index": 14,
      "text": "ما حدث، حدث.",
      "file": "c014.ogg",
      "durationSec": 4.392
    },
    {
      "index": 15,
      "text": "ما تبقى يمكن أن ينتظر حتى الصباح.",
