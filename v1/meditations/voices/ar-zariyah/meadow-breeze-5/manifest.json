{
  "id": "meadow-breeze-5",
  "voiceId": "ar-zariyah",
  "edgeVoice": "ar-SA-ZariyahNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 391,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "خذ مقعدًا مريحًا، أو استلقِ إذا كان ذلك أفضل.",
      "file": "c001.ogg",
      "durationSec": 8.52
    },
    {
      "index": 2,
      "text": "دع يديك ترتاح.",
      "file": "c002.ogg",
      "durationSec": 4.104
    },
    {
      "index": 3,
      "text": "اسمح لعينيك بإغلاق أو تخفيف نظرتك.",
      "file": "c003.ogg",
      "durationSec": 7.176
    },
    {
      "index": 4,
      "text": "لاحظ وزن جسمك الذي يحمله.",
      "file": "c004.ogg",
      "durationSec": 5.664
    },
    {
      "index": 5,
      "text": "خذ نفسا بطيئا من خلال الأنف.",
      "file": "c005.ogg",
      "durationSec": 5.664
    },
    {
      "index": 6,
      "text": "وزفير أطول وأسهل.",
      "file": "c006.ogg",
      "durationSec": 4.608
    },
    {
      "index": 7,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c007.ogg",
      "durationSec": 7.224
    },
    {
      "index": 8,
      "text": "زفير لطيف.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "إذا شردت الأفكار، فلا بأس. العودة إلى التنفس.",
      "file": "c009.ogg",
      "durationSec": 10.416
    },
    {
      "index": 10,
      "text": "تخيل مرجًا جبليًا واسعًا في وقت متأخر من الصباح.",
      "file": "c010.ogg",
      "durationSec": 8.904
    },
    {
      "index": 11,
      "text": "الأعشاب الطويلة تتمايل في موجات سهلة.",
      "file": "c011.ogg",
      "durationSec": 7.296
    },
    {
      "index": 12,
      "text": "الشمس دافئة دون أن تكون حادة.",
      "file": "c012.ogg",
      "durationSec": 6.12
    },
    {
      "index": 13,
      "text": "اشعر بها على تاج رأسك، لطيفًا وثابتًا.",
      "file": "c013.ogg",
      "durationSec": 7.944
    },
    {
      "index": 14,
      "text": "نسيم منعش يتحرك عبر العشب ويجد وجهك.",
      "file": "c014.ogg",
      "durationSec": 8.616
    },
    {
      "index": 15,
      "text": "تنبعث منه رائحة الزهور البرية والأرض المجففة بالشمس.",
      "file": "c015.ogg",
      "durationSec": 9.72
    },
    {
      "index": 16,
      "text": "أنت تمشي ببطء، وأطراف أصابعك تمسح رؤوس البذور.",
      "file": "c016.ogg",
      "durationSec": 9.768
    },
    {
      "index": 17,
      "text": "دغدغة ناعمة. صوت ناعم.",
      "file": "c017.ogg",
      "durationSec": 7.44
    },
    {
      "index": 18,
      "text": "ترفع الفراشات وتستقر مرة أخرى، على مهل.",
      "file": "c018.ogg",
      "durationSec": 8.376
    },
    {
      "index": 19,
      "text": "يمكنك العثور على مكان للاستلقاء على العشب.",
      "file": "c019.ogg",
      "durationSec": 7.848
    },
    {
      "index": 20,
      "text": "الأرض تحمل طولك كله.",
      "file": "c020.ogg",
      "durationSec": 5.136
    },
    {
      "index": 21,
      "text": "الدفء على طول الجبهة الخاصة بك. ظل التربة البارد على جانبيك.",
      "file": "c021.ogg",
      "durationSec": 11.496
    },
    {
      "index": 22,
      "text": "النسيم يأتي ويذهب مثل المد الصديق.",
      "file": "c022.ogg",
      "durationSec": 6.72
    },
    {
      "index": 23,
      "text": "يستنشق نضارة. الزفير في السماء المفتوحة.",
      "file": "c023.ogg",
      "durationSec": 8.76
    },
    {
      "index": 24,
      "text": "تنزلق سحابة عبر الشمس للحظة.",
      "file": "c024.ogg",
      "durationSec": 6.24
    },
    {
      "index": 25,
      "text": "البرودة. ثم يعود الدفء إلى وجهك.",
      "file": "c025.ogg",
      "durationSec": 8.352
    },
    {
      "index": 26,
      "text": "لاحظ مدى ضخامة الشعور بالهدوء.",
      "file": "c026.ogg",
      "durationSec": 6.264
    },
    {
      "index": 27,
      "text": "كم يبدو أي قلق صغيرًا في هذا المجال الواسع.",
      "file": "c027.ogg",
      "durationSec": 7.32
    },
    {
      "index": 28,
      "text": "يديك تستريح في العشب. اضغط على السيقان الصغيرة بلطف.",
      "file": "c028.ogg",
      "durationSec": 10.44
    },
    {
      "index": 29,
      "text": "ابق مع دفء الشمس على عينيك المغمضتين.",
      "file": "c029.ogg",
      "durationSec": 7.08
    },
    {
      "index": 30,
      "text": "ابق مع الضغط الناعم على العشب على ذراعيك.",
      "file": "c030.ogg",
      "durationSec": 7.056
    },
    {
      "index": 31,
      "text": "يُسمح لك أن تكون على هذا النحو.",
      "file": "c031.ogg",
      "durationSec": 5.88
    },
    {
      "index": 32,
      "text": "دع المرج يتنفسك لبضع دورات أخرى.",
      "file": "c032.ogg",
      "durationSec": 6.984
    },
    {
      "index": 33,
      "text": "لفت انتباهك من تاج الرأس الدافئ",
      "file": "c033.ogg",
      "durationSec": 6.072
    },
    {
      "index": 34,
      "text": "للأسفل من خلال وجه ناعم، وحلق ناعم،",
      "file": "c034.ogg",
      "durationSec": 7.824
    },
    {
      "index": 35,
      "text": "في صندوق يرتفع بسهولة تحت السماء المفتوحة.",
      "file": "c035.ogg",
      "durationSec": 8.208
    },
    {
      "index": 36,
      "text": "النسيم يجد داخل معصميك.",
      "file": "c036.ogg",
      "durationSec": 5.688
    },
    {
      "index": 37,
      "text": "رائع. على قيد الحياة. ودي.",
      "file": "c037.ogg",
      "durationSec": 9.144
    },
    {
      "index": 38,
      "text": "في مكان ما يعمل النحل دون إلحاح.",
      "file": "c038.ogg",
      "durationSec": 6.144
    },
    {
      "index": 39,
      "text": "همهمةهم هي نوع آخر من الهدوء.",
      "file": "c039.ogg",
      "durationSec": 6.6
    },
    {
      "index": 40,
      "text": "ابق حتى يشعر بالدفء والانتعاش وكأنه نسيج واحد.",
      "file": "c040.ogg",
      "durationSec": 9.264
    },
    {
      "index": 41,
      "text": "الآن استرح في أنفاسك وحدك لبعض الوقت.",
      "file": "c041.ogg",
      "durationSec": 6.984
    },
    {
      "index": 42,
      "text": "يستنشق ببطء.",
      "file": "c042.ogg",
      "durationSec": 3.96
    },
    {
      "index": 43,
      "text": "الزفير ببطء.",
      "file": "c043.ogg",
      "durationSec": 3.648
    },
    {
      "index": 44,
      "text": "يستنشق.",
      "file": "c044.ogg",
      "durationSec": 2.976
    },
    {
      "index": 45,
      "text": "الزفير.",
      "file": "c045.ogg",
      "durationSec": 3.048
    },
    {
      "index": 46,
      "text": "اشعر بالدفء أينما كان الجسم دافئًا.",
      "file": "c046.ogg",
      "durationSec": 6.624
    },
    {
      "index": 47,
      "text": "اشعر بالبرودة أينما كان الهواء باردًا.",
      "file": "c047.ogg",
      "durationSec": 7.032
    },
    {
      "index": 48,
      "text": "يستنشق.",
      "file": "c048.ogg",
      "durationSec": 2.976
    },
    {
      "index": 49,
      "text": "الزفير.",
      "file": "c049.ogg",
      "durationSec": 3.048
    },
    {
      "index": 50,
      "text": "لا مكان للذهاب. لا شيء لإصلاحه.",
      "file": "c050.ogg",
      "durationSec": 8.184
    },
    {
      "index": 51,
      "text": "يستنشق.",
      "file": "c051.ogg",
      "durationSec": 2.976
    },
    {
      "index": 52,
      "text": "الزفير.",
      "file": "c052.ogg",
      "durationSec": 3.048
    },
    {
      "index": 53,
      "text": "استرح هنا لبضع أنفاس هادئة.",
      "file": "c053.ogg",
      "durationSec": 5.856
    },
    {
      "index": 54,
      "text": "اعلم أنه يمكنك العودة إلى هذا المكان في أي وقت.",
      "file": "c054.ogg",
      "durationSec": 8.184
    },
    {
      "index": 55,
      "text": "عندما تكون مستعدًا، قم بتعميق أنفاسك.",
      "file": "c055.ogg",
      "durationSec": 7.92
    },
    {
      "index": 56,
      "text": "تذبذب أصابع اليدين والقدمين.",
      "file": "c056.ogg",
      "durationSec": 6.0
    },
    {
      "index": 57,
      "text": "افتح عينيك بهدوء.",
      "file": "c057.ogg",
      "durationSec": 4.56
    },
    {
      "index": 58,
      "text": "احمل القليل من هذا السلام معك.",
      "file": "c058.ogg",
      "durationSec": 5.712
    }
  ]
}
